# Railway/Server (Railway sets PORT automatically)
PORT=4321
HOST=0.0.0.0

# Database
DATABASE_URL=postgres://user:password@host:5432/db

# Internal admin auth (Kuula - Fase 2)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
ADMIN_AUTH_ADMIN_EMAILS=admin@invierta.com
ADMIN_AUTH_EDITOR_EMAILS=editor@invierta.com

# Temporary legacy fallback (disable when migration is complete)
ADMIN_TOKEN_FALLBACK=true
ADMIN_TOKEN=change-me-super-secret-token

# SIMI API
SIMI_API_URL=http://simi-api.com/ApiSimiweb/response
SIMI_API_KEY=your-simi-api-key-here
SIMI_INMOBILIARIA_ID=188

# Cache (Railway Redis)
# You can use either REDIS_URL or REDIS
REDIS_URL=redis://default:password@redis.railway.internal:6379
PROPERTIES_CACHE_TTL_SECONDS=300
PROPERTIES_CACHE_STALE_SECONDS=900
PROPERTIES_PREWARM_ENABLED=true
PROPERTIES_PREWARM_DELAY_MS=4000
# Optional CSV list of cities to prewarm (defaults: Pereira,Dosquebradas)
# PROPERTIES_PREWARM_CITIES=Pereira,Dosquebradas

# WhatsApp
WHATSAPP_NUMBER=573001234567

# Sitio
SITE_URL=https://inviertainmobiliaria.com
SITE_NAME=Invierta Inmobiliaria

# Google Maps (PUBLIC_ prefix exposes to client-side for Street View embed)
PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# GoHighLevel CRM Integration
# Must be prefixed with PUBLIC_ to be available in client-side code
PUBLIC_GHL_WEBHOOK_URL=https://services.leadconnectorhq.com/hooks/YOUR_LOCATION_ID/webhook-trigger/YOUR_WEBHOOK_ID
