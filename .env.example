# Railway/Server (Railway sets PORT automatically)
PORT=4321
HOST=0.0.0.0

# Database
DATABASE_URL=postgres://user:password@host:5432/db

# Internal admin auth
ADMIN_TOKEN=change-me-super-secret-token
# Optional: admin cookie/session duration in seconds (default 43200 = 12h)
ADMIN_SESSION_MAX_AGE_SECONDS=43200
# Optional: basic rate limit for /admin/* and /api/admin/*
ADMIN_RATE_LIMIT_MAX_REQUESTS=120
ADMIN_RATE_LIMIT_WINDOW_SECONDS=60

# SIMI API
SIMI_API_URL=http://simi-api.com/ApiSimiweb/response
SIMI_API_KEY=your-simi-api-key-here
SIMI_INMOBILIARIA_ID=188

# Cache (Railway Redis)
# You can use either REDIS_URL or REDIS
REDIS_URL=redis://default:password@redis.railway.internal:6379
PROPERTIES_CACHE_TTL_SECONDS=300
PROPERTIES_CACHE_STALE_SECONDS=900
PROPERTIES_PREWARM_ENABLED=true
PROPERTIES_PREWARM_DELAY_MS=4000
# Optional CSV list of cities to prewarm (defaults: Pereira,Dosquebradas)
# PROPERTIES_PREWARM_CITIES=Pereira,Dosquebradas

# WhatsApp
WHATSAPP_NUMBER=573001234567

# Sitio
SITE_URL=https://inviertainmobiliaria.com
SITE_NAME=Invierta Inmobiliaria

# Google Maps (PUBLIC_ prefix exposes to client-side for Street View embed)
PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# GoHighLevel CRM Integration
# Un webhook por tipo de solicitud (solicitud_type). Si NO hay webhook configurado
# para un solicitud_type, el lead se guarda en BD local pero NO se reenvía a GHL
# (queda registrado en audit_events como ghl_forward_skipped).
GHL_WEBHOOK_RENTAR_COMPRAR=https://services.leadconnectorhq.com/hooks/YOUR_LOCATION_ID/webhook-trigger/YOUR_WEBHOOK_ID
# Pendientes (crear workflow + webhook en GHL antes de setear):
# GHL_WEBHOOK_CONSTRUCTOR_INVERSIONISTA=
# GHL_WEBHOOK_CONSIGNAR_AVALUAR=
# GHL_WEBHOOK_CREDITO_EXTERIOR=
# GHL_WEBHOOK_CREDITO_HIPOTECARIO=
# GHL_WEBHOOK_PROPIETARIO_ARRENDATARIO=
