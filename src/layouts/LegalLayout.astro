---
import Layout from './Layout.astro';
import Breadcrumb from '../components/ui/Breadcrumb.astro';
import { SITE_CONFIG, LEGAL_LINKS } from '../lib/constants';

// Layout de las páginas legales escritas en Markdown (src/pages/*.md).
// El índice lateral se genera solo a partir de los títulos "##" del documento.
interface Props {
  frontmatter: {
    title: string;
    description: string;
    /** Fecha de la última actualización, tal como se muestra al usuario */
    updated: string;
  };
  headings: { depth: number; slug: string; text: string }[];
}

const { frontmatter, headings } = Astro.props;

const sections = headings.filter((heading) => heading.depth === 2);
const currentPath = Astro.url.pathname.replace(/\/+$/, '');
const otherDocuments = LEGAL_LINKS.filter((link) => link.href !== currentPath);

const breadcrumbItems = [
  { label: 'Inicio', href: '/' },
  { label: frontmatter.title },
];
---

<Layout title={`${frontmatter.title} | Invierta Inmobiliaria`} description={frontmatter.description}>
  <section class="bg-surface py-6">
    <div class="container-custom">
      <Breadcrumb items={breadcrumbItems} />
    </div>
  </section>

  <section class="pt-10 lg:pt-12">
    <div class="container-custom">
      <div class="hero-dark overflow-hidden rounded-2xl text-center">
        <div class="p-8 md:p-12">
          <img
            src={SITE_CONFIG.logo}
            alt={`${SITE_CONFIG.name} Logo`}
            class="mx-auto h-12 w-auto lg:h-14"
            width="224"
            height="56"
          />
          <p class="mt-6 text-xs font-semibold uppercase tracking-wider text-accent-light">Documento legal</p>
          <h1 class="mt-2 font-heading text-3xl font-bold text-white lg:text-5xl">{frontmatter.title}</h1>
          <p class="mx-auto mt-4 max-w-2xl text-base text-white/85 md:text-lg">{frontmatter.description}</p>
          <p class="mt-6 text-sm text-white/60">Última actualización: {frontmatter.updated}</p>
        </div>
        <div class="gradient-line"></div>
      </div>
    </div>
  </section>

  <section class="py-10 lg:py-14">
    <div class="container-custom">
      <div class="grid gap-10 lg:grid-cols-[280px_minmax(0,1fr)] lg:gap-14">
        <aside class="space-y-4 lg:sticky lg:top-28 lg:self-start">
          <nav aria-label="Contenido del documento" class="rounded-xl border border-border bg-surface p-5">
            <p class="font-heading text-sm font-semibold uppercase tracking-wider text-text-primary">Contenido</p>
            <ol class="mt-3 list-decimal space-y-2 pl-5 text-sm text-text-secondary marker:font-semibold marker:text-accent">
              {sections.map((section) => (
                <li>
                  <a href={`#${section.slug}`} class="transition-colors duration-150 hover:text-accent">
                    {section.text}
                  </a>
                </li>
              ))}
            </ol>
          </nav>

          <div class="rounded-xl border border-border bg-white p-5 text-sm">
            <p class="font-semibold text-text-primary">¿Tienes dudas sobre este documento?</p>
            <a
              href={`mailto:${SITE_CONFIG.email}`}
              class="mt-1 inline-block break-all font-medium text-navy-light transition-colors duration-150 hover:text-accent"
            >
              {SITE_CONFIG.email}
            </a>
            {otherDocuments.map((link) => (
              <a
                href={link.href}
                class="mt-3 flex items-center gap-1 border-t border-border pt-3 font-medium text-text-secondary transition-colors duration-150 hover:text-accent"
              >
                {link.label}
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="m9 18 6-6-6-6"/>
                </svg>
              </a>
            ))}
          </div>
        </aside>

        <article class="legal-content max-w-3xl">
          <slot />
        </article>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* El contenido viene del Markdown, por eso los selectores son :global */
  .legal-content {
    counter-reset: legal-section;
    color: var(--color-text-secondary);
    line-height: 1.75;
  }

  .legal-content > :global(:first-child) {
    margin-top: 0;
  }

  .legal-content :global(h2) {
    counter-increment: legal-section;
    margin-top: 2.75rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--color-border);
    font-size: 1.375rem;
    color: var(--color-primary);
    /* Compensa el header fijo al navegar desde el índice */
    scroll-margin-top: 5.5rem;
  }

  .legal-content :global(h2::before) {
    content: counter(legal-section) '. ';
    color: var(--color-accent);
  }

  .legal-content :global(h3) {
    margin-top: 1.75rem;
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--color-text-primary);
    scroll-margin-top: 5.5rem;
  }

  .legal-content :global(p),
  .legal-content :global(ul),
  .legal-content :global(ol) {
    margin-top: 1rem;
  }

  .legal-content :global(ul) {
    list-style: disc;
    padding-left: 1.25rem;
  }

  .legal-content :global(ol) {
    list-style: decimal;
    padding-left: 1.25rem;
  }

  .legal-content :global(li) {
    margin-top: 0.5rem;
    padding-left: 0.25rem;
  }

  .legal-content :global(li::marker) {
    color: var(--color-accent);
  }

  .legal-content :global(strong) {
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .legal-content :global(a) {
    font-weight: 500;
    color: var(--color-navy-light);
    text-decoration: underline;
    text-underline-offset: 3px;
    overflow-wrap: anywhere;
    transition: color 0.15s ease;
  }

  .legal-content :global(a:hover) {
    color: var(--color-accent);
  }

  /* Avisos destacados (declaraciones que Google exige de forma literal) */
  .legal-content :global(blockquote) {
    margin-top: 1.25rem;
    padding: 1rem 1.25rem;
    border-left: 3px solid var(--color-brand-purple);
    border-radius: 0 0.5rem 0.5rem 0;
    background-color: var(--color-surface);
    color: var(--color-text-primary);
  }

  .legal-content :global(blockquote > :first-child) {
    margin-top: 0;
  }

  @media (min-width: 1024px) {
    .legal-content :global(h2) {
      font-size: 1.5rem;
      scroll-margin-top: 6.5rem;
    }

    .legal-content :global(h3) {
      scroll-margin-top: 6.5rem;
    }
  }
</style>
