---
import Layout from '../../layouts/Layout.astro';
import { getAdminAuthState, isAdminTokenConfigured, loginWithAdminToken } from '../../lib/adminAuth';

export const prerender = false;

let error = '';
const nextPath = Astro.url.searchParams.get('next') || '/admin/kuula';

const existingAuth = await getAdminAuthState(Astro.request, Astro.cookies);
if (existingAuth.isAuthenticated) {
  return Astro.redirect(nextPath);
}

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const nextFromForm = String(form.get('next') || '').trim();
  const token = String(form.get('token') || '').trim();

  if (!isAdminTokenConfigured()) {
    error = 'ADMIN_TOKEN no está configurado en el servidor.';
  } else if (!token) {
    error = 'Debes ingresar el token de acceso admin.';
  } else {
    try {
      loginWithAdminToken(Astro.cookies, token);
      return Astro.redirect(nextFromForm || nextPath);
    } catch (err) {
      error = err instanceof Error ? err.message : 'No fue posible iniciar sesión.';
    }
  }
}
---

<Layout title="Login Admin | Invierta" description="Acceso al panel interno de Kuula">
  <section class="py-10">
    <div class="container-custom max-w-md">
      <div class="rounded-xl border border-border bg-white p-6 shadow-sm">
        <h1 class="font-heading text-2xl font-bold text-text-primary">Acceso admin</h1>
        <p class="mt-1 text-sm text-text-secondary">Ingresa el token para gestionar Kuula.</p>

        {!isAdminTokenConfigured() && (
          <div class="mt-5 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
            Falta configurar <strong>ADMIN_TOKEN</strong> en el servidor.
          </div>
        )}

        {error && (
          <div class="mt-5 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
            {error}
          </div>
        )}

        <form method="POST" class="mt-6 space-y-4">
          <input type="hidden" name="next" value={nextPath} />

          <div>
            <label for="token" class="mb-1 block text-sm font-medium text-text-primary">Token admin</label>
            <input id="token" name="token" type="password" autocomplete="off" required class="w-full rounded-lg border border-border px-3 py-2 text-sm outline-none focus:border-primary" />
          </div>

          <button type="submit" class="w-full rounded-lg bg-primary px-4 py-2 text-sm font-semibold text-white hover:opacity-90" disabled={!isAdminTokenConfigured()}>
            Ingresar
          </button>
        </form>
      </div>
    </div>
  </section>
</Layout>
