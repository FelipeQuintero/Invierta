---
import Layout from '../../layouts/Layout.astro';
import { getAdminAuthState } from '../../lib/adminAuth';
import { getKuulaEmbedUrl, getKuulaLinkHistory, isValidKuulaEmbedUrl, normalizeKuulaUrl, searchPropertiesForAdmin, upsertKuulaEmbedUrl, type AdminPropertySearchResult } from '../../lib/kuula';
import { getPropertyById } from '../../lib/simi';

export const prerender = false;

type MessageType = 'success' | 'error' | 'info';
type BulkRowResult = { row: number; propertyId: string; ok: boolean; message: string };

function parseCsv(text: string): Array<{ propertyId: string; kuulaUrl: string; row: number }> {
  const lines = text
    .split(/\r?\n/)
    .map((line) => line.trim())
    .filter(Boolean);

  if (lines.length === 0) return [];

  const looksLikeHeader = /^propertyid\s*,\s*kuulaurl$/i.test(lines[0].replace(/\s+/g, ''));
  const dataLines = looksLikeHeader ? lines.slice(1) : lines;

  return dataLines.map((line, index) => {
    const parts = line.split(',');
    const propertyId = (parts[0] || '').trim();
    const kuulaUrl = parts.slice(1).join(',').trim();
    return { propertyId, kuulaUrl, row: looksLikeHeader ? index + 2 : index + 1 };
  });
}

let message = '';
let messageType: MessageType = 'info';
let propertyIdValue = '';
let kuulaUrlValue = '';
let searchValue = '';
let propertyPreview: Awaited<ReturnType<typeof getPropertyById>>;
let searchResults: AdminPropertySearchResult[] = [];
let historyRows = await getKuulaLinkHistory({ limit: 30 });
let bulkSummary: { total: number; ok: number; error: number } | null = null;
let bulkResults: BulkRowResult[] = [];

const prefill = (Astro.url.searchParams.get('propertyId') || '').trim();

if (prefill) propertyIdValue = prefill;

const auth = await getAdminAuthState(Astro.request, Astro.cookies, ['admin', 'editor']);
if (!auth.isAuthenticated) {
  return Astro.redirect('/admin/login?next=/admin/kuula');
}

if (propertyIdValue && Astro.request.method !== 'POST') {
  propertyPreview = await getPropertyById(propertyIdValue);
  const existingKuula = await getKuulaEmbedUrl(propertyIdValue);
  if (existingKuula) kuulaUrlValue = existingKuula;
}

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const intent = String(formData.get('intent') || 'save');
  propertyIdValue = String(formData.get('propertyId') || '').trim();
  kuulaUrlValue = String(formData.get('kuulaEmbedUrl') || '').trim();
  searchValue = String(formData.get('searchQuery') || '').trim();

    if (intent === 'search') {
      if (!searchValue) {
        message = 'Ingresa un texto para buscar (ID, ciudad o barrio).';
        messageType = 'error';
      } else {
        searchResults = await searchPropertiesForAdmin(searchValue, 20);
        if (searchResults.length === 0) {
          message = `No hubo resultados para "${searchValue}".`;
          messageType = 'error';
        } else {
          message = `${searchResults.length} resultado(s) encontrados para "${searchValue}".`;
          messageType = 'success';
        }
      }
    } else if (intent === 'save') {
      if (!propertyIdValue) {
        message = 'Debes ingresar el ID/código de propiedad.';
        messageType = 'error';
      } else {
        propertyPreview = await getPropertyById(propertyIdValue);

        if (!propertyPreview) {
          message = `No se encontró la propiedad ${propertyIdValue}.`;
          messageType = 'error';
        } else if (!kuulaUrlValue) {
          message = 'Debes ingresar la URL embed de Kuula.';
          messageType = 'error';
        } else if (!isValidKuulaEmbedUrl(kuulaUrlValue)) {
          message = 'La URL no es válida o no pertenece a Kuula.';
          messageType = 'error';
        } else {
          const saveResult = await upsertKuulaEmbedUrl(propertyIdValue, normalizeKuulaUrl(kuulaUrlValue), 'panel_admin');
          message = saveResult.previousUrl
            ? `Link 360 actualizado para ${propertyIdValue}.`
            : `Link 360 guardado para ${propertyIdValue}.`;
          messageType = 'success';
          historyRows = await getKuulaLinkHistory({ limit: 30 });
        }
      }
    } else if (intent === 'bulk_upload') {
      const csvFile = formData.get('bulkCsv');
      if (!(csvFile instanceof File) || csvFile.size === 0) {
        message = 'Debes seleccionar un CSV con columnas propertyId,kuulaUrl.';
        messageType = 'error';
      } else {
        const content = await csvFile.text();
        const rows = parseCsv(content);

        if (rows.length === 0) {
          message = 'El CSV está vacío o no tiene filas válidas.';
          messageType = 'error';
        } else {
          bulkSummary = { total: rows.length, ok: 0, error: 0 };
          bulkResults = [];

          for (const row of rows) {
            if (!row.propertyId || !row.kuulaUrl) {
              bulkSummary.error += 1;
              bulkResults.push({ row: row.row, propertyId: row.propertyId, ok: false, message: 'Faltan columnas propertyId/kuulaUrl' });
              continue;
            }

            if (!isValidKuulaEmbedUrl(row.kuulaUrl)) {
              bulkSummary.error += 1;
              bulkResults.push({ row: row.row, propertyId: row.propertyId, ok: false, message: 'URL Kuula inválida' });
              continue;
            }

            const property = await getPropertyById(row.propertyId);
            if (!property) {
              bulkSummary.error += 1;
              bulkResults.push({ row: row.row, propertyId: row.propertyId, ok: false, message: 'Propiedad no encontrada en SIMI' });
              continue;
            }

            await upsertKuulaEmbedUrl(row.propertyId, normalizeKuulaUrl(row.kuulaUrl), 'panel_admin_csv');
            bulkSummary.ok += 1;
            bulkResults.push({ row: row.row, propertyId: row.propertyId, ok: true, message: 'Actualizado correctamente' });
          }

          message = `Carga masiva finalizada. OK: ${bulkSummary.ok} · Error: ${bulkSummary.error} · Total: ${bulkSummary.total}.`;
          messageType = bulkSummary.error > 0 ? 'info' : 'success';
          historyRows = await getKuulaLinkHistory({ limit: 30 });
        }
      }
    }

  if (propertyIdValue) {
    propertyPreview = await getPropertyById(propertyIdValue);
    const existingKuula = await getKuulaEmbedUrl(propertyIdValue);
    if (existingKuula && !kuulaUrlValue) kuulaUrlValue = existingKuula;
  }
}
---

<Layout title="Admin Kuula | Invierta" description="Gestión interna de enlaces Kuula por propiedad">
  <section class="py-10">
    <div class="container-custom max-w-5xl space-y-6">
      <div class="rounded-xl border border-border bg-white p-6 shadow-sm">
        <div class="flex items-center justify-between gap-4">
          <div>
            <h1 class="font-heading text-2xl font-bold text-text-primary">Admin Kuula</h1>
            <p class="mt-1 text-sm text-text-secondary">Asignar/actualizar links 360, buscar propiedades y carga masiva CSV.</p>
          </div>
          <a href="/admin/logout" class="text-sm text-text-muted underline hover:text-text-primary">Cerrar sesión</a>
        </div>

        <div class="mt-4 rounded-lg border border-blue-200 bg-blue-50 px-4 py-3 text-sm text-blue-800">
          Sesión activa como <strong>{auth.email || 'usuario legado por token'}</strong> ({auth.role || 'admin'}).
        </div>

        <div class="mt-5 rounded-lg border border-blue-200 bg-blue-50 px-4 py-3 text-sm text-blue-800">
          Acceso MVP por token activo para continuidad operativa.
        </div>

        {message && (
          <div class={`mt-5 rounded-lg px-4 py-3 text-sm ${messageType === 'success' ? 'border border-green-200 bg-green-50 text-green-700' : messageType === 'error' ? 'border border-red-200 bg-red-50 text-red-700' : 'border border-blue-200 bg-blue-50 text-blue-700'}`}>
            {message}
          </div>
        )}

        <div class="mt-6 space-y-6">
          <form method="POST" class="space-y-3 rounded-lg border border-border p-4">
            <h2 class="text-sm font-semibold text-text-primary">1) Buscar propiedad (ID/código, ciudad o barrio)</h2>
            <div class="flex flex-col gap-3 sm:flex-row">
              <input
                id="searchQuery"
                name="searchQuery"
                type="text"
                value={searchValue}
                placeholder="Ej: 188-2470, Pereira, Pinares"
                class="w-full rounded-lg border border-border px-3 py-2 text-sm outline-none focus:border-primary"
              />
              <button type="submit" name="intent" value="search" class="rounded-lg border border-border px-4 py-2 text-sm font-semibold text-text-primary hover:bg-surface">
                Buscar
              </button>
            </div>
          </form>

          {searchResults.length > 0 && (
            <div class="rounded-lg border border-border p-4">
              <p class="mb-3 text-sm font-semibold text-text-primary">Resultados de búsqueda</p>
              <div class="space-y-2">
                {searchResults.map((result) => (
                  <a href={`/admin/kuula?propertyId=${encodeURIComponent(result.id)}`} class="block rounded-md border border-border px-3 py-2 text-sm hover:bg-surface">
                    <strong>{result.id}</strong> — {result.title} <span class="text-text-muted">({result.neighborhood}, {result.city})</span>
                  </a>
                ))}
              </div>
            </div>
          )}

          <form method="POST" class="space-y-4 rounded-lg border border-border p-4">
            <h2 class="text-sm font-semibold text-text-primary">2) Guardar link individual</h2>
            <div>
              <label for="propertyId" class="mb-1 block text-sm font-medium text-text-primary">ID / código SIMI</label>
              <input id="propertyId" name="propertyId" type="text" value={propertyIdValue} placeholder="Ej: 188-2470" class="w-full rounded-lg border border-border px-3 py-2 text-sm outline-none focus:border-primary" required />
            </div>

            <div>
              <label for="kuulaEmbedUrl" class="mb-1 block text-sm font-medium text-text-primary">URL embed Kuula</label>
              <input id="kuulaEmbedUrl" name="kuulaEmbedUrl" type="url" value={kuulaUrlValue} placeholder="https://kuula.co/share/..." class="w-full rounded-lg border border-border px-3 py-2 text-sm outline-none focus:border-primary" />
            </div>

            <button type="submit" name="intent" value="save" class="rounded-lg bg-primary px-4 py-2 text-sm font-semibold text-white hover:opacity-90">Guardar link Kuula</button>
          </form>

          <form method="POST" enctype="multipart/form-data" class="space-y-4 rounded-lg border border-border p-4">
            <h2 class="text-sm font-semibold text-text-primary">3) Carga masiva por CSV (opcional)</h2>
            <p class="text-xs text-text-secondary">Formato: <code>propertyId,kuulaUrl</code> (con o sin encabezado).</p>
            <input name="bulkCsv" type="file" accept=".csv,text/csv" class="block w-full rounded-lg border border-border px-3 py-2 text-sm" />
            <button type="submit" name="intent" value="bulk_upload" class="rounded-lg border border-border px-4 py-2 text-sm font-semibold text-text-primary hover:bg-surface">Procesar CSV</button>

            {bulkSummary && (
              <div class="rounded-lg border border-border bg-surface px-3 py-2 text-sm">
                <strong>Resumen:</strong> {bulkSummary.ok} OK · {bulkSummary.error} con error · {bulkSummary.total} total
              </div>
            )}

            {bulkResults.length > 0 && (
              <div class="max-h-64 overflow-auto rounded-lg border border-border">
                <table class="min-w-full text-sm">
                  <thead class="bg-surface text-left">
                    <tr>
                      <th class="px-3 py-2">Fila</th>
                      <th class="px-3 py-2">Propiedad</th>
                      <th class="px-3 py-2">Estado</th>
                      <th class="px-3 py-2">Mensaje</th>
                    </tr>
                  </thead>
                  <tbody>
                    {bulkResults.map((row) => (
                      <tr class="border-t border-border">
                        <td class="px-3 py-2">{row.row}</td>
                        <td class="px-3 py-2">{row.propertyId || '-'}</td>
                        <td class={`px-3 py-2 font-semibold ${row.ok ? 'text-green-700' : 'text-red-700'}`}>{row.ok ? 'OK' : 'ERROR'}</td>
                        <td class="px-3 py-2">{row.message}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}
          </form>
        </div>

        {propertyPreview && (
          <div class="mt-6 rounded-lg border border-border bg-surface p-4 text-sm text-text-secondary">
            <p><strong class="text-text-primary">Propiedad:</strong> {propertyPreview.title}</p>
            <p><strong class="text-text-primary">ID:</strong> {propertyPreview.id}</p>
            <p><strong class="text-text-primary">Ubicación:</strong> {propertyPreview.neighborhood}, {propertyPreview.city}</p>
          </div>
        )}
      </div>

      <div class="rounded-xl border border-border bg-white p-6 shadow-sm">
        <h2 class="text-lg font-semibold text-text-primary">Historial de cambios Kuula</h2>
        <p class="mt-1 text-sm text-text-secondary">Últimos cambios guardados (quién, cuándo, URL anterior y nueva).</p>

        {historyRows.length === 0 ? (
          <p class="mt-4 text-sm text-text-secondary">Sin historial aún.</p>
        ) : (
          <div class="mt-4 max-h-96 overflow-auto rounded-lg border border-border">
            <table class="min-w-full text-sm">
              <thead class="bg-surface text-left">
                <tr>
                  <th class="px-3 py-2">Fecha</th>
                  <th class="px-3 py-2">Propiedad</th>
                  <th class="px-3 py-2">Quién</th>
                  <th class="px-3 py-2">URL anterior</th>
                  <th class="px-3 py-2">URL nueva</th>
                </tr>
              </thead>
              <tbody>
                {historyRows.map((row) => (
                  <tr class="border-t border-border align-top">
                    <td class="px-3 py-2">{new Date(row.changedAt).toLocaleString('es-CO')}</td>
                    <td class="px-3 py-2">{row.propertyId}</td>
                    <td class="px-3 py-2">{row.changedBy}</td>
                    <td class="px-3 py-2 break-all text-xs">{row.previousKuulaEmbedUrl || '-'}</td>
                    <td class="px-3 py-2 break-all text-xs">{row.newKuulaEmbedUrl}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </div>
    </div>
  </section>
</Layout>
