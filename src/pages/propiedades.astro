---
import Layout from '../layouts/Layout.astro';
import PropertyListingContent from '../components/properties/PropertyListingContent.tsx';
import PropertyFilters from '../components/properties/PropertyFilters.tsx';
import Breadcrumb from '../components/ui/Breadcrumb.astro';
import { getProperties } from '../lib/simi';
import type { PropertyFilters as PropertyFiltersType, OperationType } from '../lib/types';

export const prerender = false;

const url = Astro.url;
const params = url.searchParams;

const filters: PropertyFiltersType = {};

const operationParam = params.get('operation');
if (operationParam === 'venta' || operationParam === 'arriendo') {
  filters.operation = operationParam as OperationType;
}

if (params.get('code')) filters.code = params.get('code') || undefined;
if (params.get('locationQuery')) filters.locationQuery = params.get('locationQuery') || undefined;
if (params.get('propertyType')) {
  const val = params.get('propertyType') || '';
  if (!val.includes(',')) {
    filters.propertyType = val as PropertyFiltersType['propertyType'];
  }
}
if (params.get('city')) filters.city = params.get('city') || undefined;
if (params.get('zone')) filters.zone = params.get('zone') || undefined;
if (params.get('minPrice')) filters.minPrice = parseInt(params.get('minPrice') || '0');
if (params.get('maxPrice')) filters.maxPrice = parseInt(params.get('maxPrice') || '0');
if (params.get('bedrooms')) filters.bedrooms = parseInt(params.get('bedrooms') || '0');
if (params.get('bathrooms')) filters.bathrooms = parseInt(params.get('bathrooms') || '0');
if (params.get('minArea')) filters.minArea = parseInt(params.get('minArea') || '0');
if (params.get('maxArea')) filters.maxArea = parseInt(params.get('maxArea') || '0');
if (params.get('parking')) filters.parking = parseInt(params.get('parking') || '0');
if (params.get('stratum')) filters.stratum = parseInt(params.get('stratum') || '0');

let properties: Awaited<ReturnType<typeof getProperties>> = [];
let fetchError = false;
try {
  properties = await getProperties(filters);
} catch (err) {
  console.error('[propiedades] getProperties failed, retrying once:', err);
  try {
    properties = await getProperties(filters);
  } catch (retryErr) {
    console.error('[propiedades] retry also failed:', retryErr);
    fetchError = true;
  }
}

// Client-side multi-type filter (SIMI API only supports one type at a time)
const multiType = params.get('propertyType');
if (multiType && multiType.includes(',')) {
  const types = multiType.split(',');
  properties = properties.filter((p) => types.includes(p.propertyType));
}

const hasActiveFilters = Array.from(params.keys()).some((k) => k !== '');

const operationLabel = operationParam === 'arriendo' ? 'en Arriendo' : operationParam === 'venta' ? 'en Venta' : '';
const pageTitle = operationLabel ? `Propiedades ${operationLabel}` : 'Propiedades';

const breadcrumbItems = [
  { label: 'Inicio', href: '/' },
  { label: pageTitle },
];
---

<Layout
  title={`${pageTitle} | Invierta Inmobiliaria`}
  description="Encuentra apartamentos, casas, locales y mas propiedades en venta y arriendo en Colombia. Amplio catalogo con los mejores precios."
>
  <section class="bg-surface py-6">
    <div class="container-custom">
      <Breadcrumb items={breadcrumbItems} />
    </div>
  </section>

  <section class="py-6 lg:py-8">
    <div class="container-custom">
      <div class="mb-6">
        <h1 class="font-heading text-3xl font-bold text-text-primary lg:text-4xl">
          {pageTitle}
        </h1>
        <p class="mt-2 text-text-secondary">
          Explora nuestro catalogo de propiedades disponibles en venta y arriendo en toda Colombia.
        </p>
      </div>

      {fetchError ? (
        <div class="rounded-xl border border-red-200 bg-red-50 p-8 text-center">
          <p class="text-lg font-semibold text-red-700">No pudimos cargar las propiedades en este momento</p>
          <p class="mt-2 text-sm text-red-600">El servidor de datos no respondió. Esto suele ser temporal.</p>
          <button onclick="window.location.reload()" class="mt-4 rounded-lg bg-primary px-6 py-2 text-white font-medium hover:bg-primary/90 transition-colors">
            Reintentar
          </button>
        </div>
      ) : (
        <div class="flex flex-col lg:flex-row lg:gap-6">
          <PropertyFilters client:load operation={operationParam || ''} />

          <PropertyListingContent
            client:load
            properties={properties}
            hasActiveFilters={hasActiveFilters}
            emptyHref="/propiedades"
            emptyLabel="Ver todas las propiedades"
            itemLabel="propiedades"
            locationQuery={params.get('locationQuery') || params.get('city') || ''}
            sortOptions={[
              { value: 'recent', label: 'Mas recientes' },
              { value: 'price-asc', label: 'Menor precio' },
              { value: 'price-desc', label: 'Mayor precio' },
              { value: 'area-desc', label: 'Mayor area' },
            ]}
          />
        </div>
      )}
    </div>
  </section>
</Layout>
