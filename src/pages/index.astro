---
import Layout from '../layouts/Layout.astro';
import HeroSearch from '../components/home/HeroSearch.tsx';
import FeaturedProperties from '../components/home/FeaturedProperties.astro';
import ServicesPreview from '../components/home/ServicesPreview.astro';
import AnimateOnScroll from '../components/ui/AnimateOnScroll.tsx';
import ProjectCard from '../components/projects/ProjectCard.tsx';
import type { Project } from '../components/projects/types';
import { getFeaturedProperties } from '../lib/simi';
import { SITE_CONFIG, CLIENT_ACCESS, PSE_PAYMENT } from '../lib/constants';
import { and, desc, eq } from 'drizzle-orm';
import { db, schema } from '../db';
import { House, KeyRound, Wallet, ArrowUpRight, ShieldCheck, Landmark } from 'lucide-react';

const CLIENT_ICONS = { owner: House, tenant: KeyRound, payment: Wallet } as const;

// Disable prerendering - fetch fresh data on each request
export const prerender = false;

const featuredProperties = await getFeaturedProperties(8);

let featuredProjects: Project[] = [];
try {
  const rows = await db
    .select()
    .from(schema.projects)
    .where(and(eq(schema.projects.isActive, true), eq(schema.projects.isFeatured, true)))
    .orderBy(desc(schema.projects.createdAt))
    .limit(4);
  featuredProjects = rows as unknown as Project[];
} catch (error) {
  console.error('Error cargando proyectos destacados:', error);
}
---

<Layout>
  <HeroSearch client:load />

  <!-- Zona de clientes: portales y pagos -->
  <section
    id="zona-clientes"
    class="scroll-mt-28 border-b border-border bg-surface py-12 md:py-16"
    aria-labelledby="zona-clientes-title"
  >
    <div class="container-custom">
      <div class="mb-8 flex flex-col gap-4 md:mb-10 md:flex-row md:items-end md:justify-between">
        <div>
          <span class="text-xs font-semibold uppercase tracking-[0.14em] text-accent">Zona de clientes</span>
          <h2 id="zona-clientes-title" class="mt-2 font-heading text-2xl font-bold text-text-primary md:text-3xl">
            Gestiona tu arriendo en línea
          </h2>
          <p class="mt-2 max-w-xl text-base text-text-secondary">
            Ingresa a tu portal o realiza tus pagos sin desplazarte a la oficina.
          </p>
        </div>
        <p class="inline-flex items-center gap-2 text-sm text-text-secondary">
          <ShieldCheck className="h-4 w-4 shrink-0 text-secondary" aria-hidden="true" />
          Plataformas seguras · se abren en una pestaña nueva
        </p>
      </div>

      <div class="grid gap-4 md:grid-cols-3 lg:gap-6">
        {CLIENT_ACCESS.map((item) => {
          const Icon = CLIENT_ICONS[item.icon];
          return (
            <a
              href={item.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${item.label} (se abre en una pestaña nueva)`}
              class:list={[
                'group relative flex h-full flex-col rounded-2xl p-6 transition-all duration-200 hover:-translate-y-1 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 lg:p-7',
                item.featured
                  ? 'bg-primary text-white shadow-lg hover:shadow-2xl'
                  : 'border border-border bg-white hover:border-navy/25 hover:shadow-xl',
              ]}
            >
              {item.featured && (
                <span class="absolute right-5 top-5 rounded-full bg-accent/15 px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wide text-accent-light">
                  Pago en línea
                </span>
              )}
              <span
                class:list={[
                  'flex h-12 w-12 items-center justify-center rounded-xl transition-colors duration-200',
                  item.featured
                    ? 'bg-accent text-white'
                    : 'bg-navy/10 text-navy group-hover:bg-navy group-hover:text-white',
                ]}
              >
                <Icon className="h-6 w-6" aria-hidden="true" />
              </span>

              <h3
                class:list={[
                  'mt-5 font-heading text-lg font-bold lg:text-xl',
                  item.featured ? 'text-white' : 'text-text-primary',
                ]}
              >
                {item.label}
              </h3>
              <p
                class:list={[
                  'mt-2 flex-1 text-sm leading-relaxed',
                  item.featured ? 'text-white/75' : 'text-text-secondary',
                ]}
              >
                {item.description}
              </p>

              {item.featured ? (
                <span class="mt-6 inline-flex w-full items-center justify-center gap-2 rounded-lg bg-accent px-5 py-3 text-sm font-semibold text-white transition-colors group-hover:bg-accent-dark">
                  {item.cta}
                  <ArrowUpRight className="h-4 w-4" aria-hidden="true" />
                </span>
              ) : (
                <span class="mt-6 inline-flex items-center gap-1.5 text-sm font-semibold text-navy transition-colors group-hover:text-accent">
                  {item.cta}
                  <ArrowUpRight className="h-4 w-4 transition-transform duration-200 group-hover:-translate-y-0.5 group-hover:translate-x-0.5" aria-hidden="true" />
                </span>
              )}
            </a>
          );
        })}
      </div>

      <!-- Pagos PSE: estudios y otros pagos -->
      <a
        href={PSE_PAYMENT.href}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`${PSE_PAYMENT.label}: ${PSE_PAYMENT.description} (se abre en una pestaña nueva)`}
        class="group mt-4 flex flex-col gap-5 rounded-2xl border border-border bg-white p-6 transition-all duration-200 hover:-translate-y-1 hover:border-navy/25 hover:shadow-xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 sm:flex-row sm:items-center lg:mt-6 lg:gap-7 lg:p-7"
      >
        <span class="flex h-20 w-20 shrink-0 items-center justify-center overflow-hidden rounded-2xl border border-border bg-white p-2 shadow-sm">
          <img
            src={PSE_PAYMENT.logo}
            alt="PSE"
            width="64"
            height="64"
            loading="lazy"
            class="h-full w-full object-contain"
            onerror="this.hidden=true;this.nextElementSibling.hidden=false;"
          />
          <span hidden class="font-heading text-xl font-extrabold tracking-tight text-navy">PSE</span>
        </span>

        <span class="flex-1">
          <span class="text-xs font-semibold uppercase tracking-[0.14em] text-text-muted">Estudios y otros pagos</span>
          <span class="mt-1 block font-heading text-lg font-bold text-text-primary lg:text-xl">{PSE_PAYMENT.label}</span>
          <span class="mt-1.5 block text-sm leading-relaxed text-text-secondary">{PSE_PAYMENT.description}</span>
          <span class="mt-2 inline-flex items-center gap-1.5 text-xs text-text-muted">
            <Landmark className="h-3.5 w-3.5 shrink-0" aria-hidden="true" />
            {PSE_PAYMENT.provider}
          </span>
        </span>

        <span class="inline-flex shrink-0 items-center justify-center gap-2 rounded-lg bg-navy px-5 py-3 text-sm font-semibold text-white transition-colors group-hover:bg-navy-dark">
          {PSE_PAYMENT.cta}
          <ArrowUpRight className="h-4 w-4" aria-hidden="true" />
        </span>
      </a>

      <p class="mt-8 text-center text-sm text-text-secondary">
        ¿Conoces a alguien que quiera vender o arrendar su inmueble?
        <a href="/referidos" class="font-semibold text-accent underline-offset-4 hover:underline">Registra un referido →</a>
      </p>
    </div>
  </section>

  <AnimateOnScroll animation="slide-up" client:visible>
    <FeaturedProperties properties={featuredProperties} />
  </AnimateOnScroll>

  <AnimateOnScroll animation="slide-up" delay={80} client:visible>
    <section class="py-4 pb-16 md:pb-20 lg:pb-24">
      <div class="container-custom">
        <div class="mb-10 text-center md:mb-14">
          <h2 class="font-heading text-3xl font-bold text-text-primary md:text-4xl">Proyectos Nuevos</h2>
          <p class="mx-auto mt-3 max-w-2xl text-base text-text-secondary md:text-lg">
            Invierte desde planos con precios de preventa
          </p>
        </div>

        {featuredProjects.length > 0 ? (
          <>
            <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
              {featuredProjects.map((project) => <ProjectCard project={project} />)}
            </div>
            <div class="mt-10 text-center md:mt-14">
              <a href="/proyectos" class="btn-outline text-sm md:text-base">
                Ver todos los proyectos
                <span aria-hidden="true">→</span>
              </a>
            </div>
          </>
        ) : (
          <p class="py-10 text-center text-text-muted">Próximamente nuevos proyectos</p>
        )}
      </div>
    </section>
  </AnimateOnScroll>

  <AnimateOnScroll animation="slide-up" delay={100} client:visible>
    <ServicesPreview />
  </AnimateOnScroll>

  <AnimateOnScroll animation="fade" delay={150} client:visible>
    <section class="bg-primary py-16 lg:py-20">
      <div class="container-custom">
        <div class="mx-auto max-w-3xl text-center">
          <h2 class="font-heading text-2xl font-bold text-white lg:text-3xl">
            Listo para encontrar tu próximo hogar?
          </h2>
          <p class="mt-4 text-white/80">
            Nuestro equipo de asesores está disponible para ayudarte a encontrar la propiedad perfecta. Contáctanos hoy mismo.
          </p>
          <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
            <a
              href={`https://wa.me/${SITE_CONFIG.whatsapp}`}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 rounded-lg bg-[#25D366] px-6 py-3 font-semibold text-white transition-colors hover:bg-[#20bd5a]"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/>
              </svg>
              Escribir por WhatsApp
            </a>
            <a
              href="/servicios"
              class="inline-flex items-center gap-2 rounded-lg border-2 border-white px-6 py-3 font-semibold text-white transition-colors hover:bg-white hover:text-primary"
            >
              Ver todos los servicios
            </a>
          </div>
        </div>
      </div>
    </section>
  </AnimateOnScroll>

  <section class="py-16 lg:py-20">
    <div class="container-custom">
      <div class="grid gap-8 md:grid-cols-3">
        <AnimateOnScroll animation="slide-up" delay={0} client:visible>
          <div class="text-center">
            <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-primary/10 text-primary">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                <polyline points="9 22 9 12 15 12 15 22"/>
              </svg>
            </div>
            <h3 class="font-heading text-xl font-semibold text-text-primary">Amplio Catálogo</h3>
            <p class="mt-2 text-text-secondary">
              Miles de propiedades en venta y arriendo en las principales ciudades de Colombia.
            </p>
          </div>
        </AnimateOnScroll>
        <AnimateOnScroll animation="slide-up" delay={150} client:visible>
          <div class="text-center">
            <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-primary/10 text-primary">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
                <circle cx="9" cy="7" r="4"/>
                <path d="M22 21v-2a4 4 0 0 0-3-3.87"/>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
              </svg>
            </div>
            <h3 class="font-heading text-xl font-semibold text-text-primary">Asesores Expertos</h3>
            <p class="mt-2 text-text-secondary">
              Equipo profesional con amplio conocimiento del mercado inmobiliario.
            </p>
          </div>
        </AnimateOnScroll>
        <AnimateOnScroll animation="slide-up" delay={300} client:visible>
          <div class="text-center">
            <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-primary/10 text-primary">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/>
                <path d="m9 12 2 2 4-4"/>
              </svg>
            </div>
            <h3 class="font-heading text-xl font-semibold text-text-primary">Confianza y Seguridad</h3>
            <p class="mt-2 text-text-secondary">
              Procesos transparentes y acompañamiento legal en cada transacción.
            </p>
          </div>
        </AnimateOnScroll>
      </div>
    </div>
  </section>
</Layout>
