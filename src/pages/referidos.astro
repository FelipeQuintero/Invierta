---
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/ui/Breadcrumb.astro';
import { SITE_CONFIG } from '../lib/constants';

export const prerender = false;

const breadcrumbItems = [
  { label: 'Inicio', href: '/' },
  { label: 'Programa de Referidos' },
];

const iconPaths: Record<string, string> = {
  Gift: '<rect x="3" y="8" width="18" height="4" rx="1"/><path d="M12 8v13"/><path d="M19 12v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7"/><path d="M12 8H7a2 2 0 1 1 0-4c3 0 5 4 5 4"/><path d="M12 8h5a2 2 0 1 0 0-4c-3 0-5 4-5 4"/>',
  Users: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
  Handshake: '<path d="m11 17 2 2a1 1 0 1 0 3-3"/><path d="m14 14 2 2a1 1 0 1 0 3-3"/><path d="m3 9 4 4"/><path d="m7 5 2 2"/><path d="M3 15h4l2.5-2.5a2.1 2.1 0 0 1 3 0l.5.5a2.1 2.1 0 0 0 3 0L21 8"/><path d="M5 3 3 5l2 2 2-2Z"/><path d="m19 17 2 2 2-2-2-2Z"/>',
};
---

<Layout
  title="Programa de Referidos | Invierta Inmobiliaria"
  description="¿Conoces a alguien buscando vivienda o local? Recomiéndanos y gana beneficios con nuestro programa de referidos."
>
  <section class="bg-surface py-6">
    <div class="container-custom">
      <Breadcrumb items={breadcrumbItems} />
    </div>
  </section>

  <section class="py-12 lg:py-16">
    <div class="container-custom">
      <div class="hero-dark overflow-hidden rounded-2xl p-8 text-center md:p-12">
        <div class="mx-auto mb-6 flex h-20 w-20 items-center justify-center rounded-full bg-white/10 text-white md:h-24 md:w-24">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-11 w-11"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            set:html={iconPaths.Gift}
          />
        </div>
        <h1 class="font-heading text-3xl font-bold text-white lg:text-5xl">Programa de Referidos</h1>
        <p class="mx-auto mt-4 max-w-2xl text-base text-white/85 md:text-lg">
          ¿Conoces a alguien buscando vivienda o local? Recomiéndanos y gana beneficios.
        </p>
      </div>
    </div>
  </section>

  <section class="pb-12 lg:pb-16">
    <div class="container-custom">
      <h2 class="text-center font-heading text-2xl font-bold text-text-primary md:text-3xl">¿Cómo funciona?</h2>
      <div class="mt-8 grid gap-4 md:grid-cols-3 md:gap-6">
        <article class="rounded-xl border border-border bg-white p-6 shadow-sm">
          <p class="text-xs font-semibold uppercase tracking-wider text-accent">Paso 1</p>
          <h3 class="mt-2 flex items-center gap-2 text-lg font-semibold text-text-primary">
            <span>🤝</span>
            Recomiéndanos
          </h3>
          <p class="mt-2 text-sm text-text-secondary">
            Comparte los datos de alguien que busque comprar, arrendar o invertir.
          </p>
        </article>
        <article class="rounded-xl border border-border bg-white p-6 shadow-sm">
          <p class="text-xs font-semibold uppercase tracking-wider text-accent">Paso 2</p>
          <h3 class="mt-2 flex items-center gap-2 text-lg font-semibold text-text-primary">
            <span>📞</span>
            Nosotros contactamos
          </h3>
          <p class="mt-2 text-sm text-text-secondary">
            Nuestro equipo se comunicará con tu referido de forma profesional.
          </p>
        </article>
        <article class="rounded-xl border border-border bg-white p-6 shadow-sm">
          <p class="text-xs font-semibold uppercase tracking-wider text-accent">Paso 3</p>
          <h3 class="mt-2 flex items-center gap-2 text-lg font-semibold text-text-primary">
            <span>🎁</span>
            Recibe tu beneficio
          </h3>
          <p class="mt-2 text-sm text-text-secondary">
            Si el referido concreta el negocio, recibes una bonificación.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="pb-12 lg:pb-16">
    <div class="container-custom">
      <div class="mx-auto max-w-4xl rounded-2xl border border-border bg-white p-6 shadow-sm lg:p-8">
        <div class="mb-6 rounded-xl border border-border bg-surface p-4 text-sm text-text-secondary">
          <p class="font-semibold text-text-primary">Completa estos 3 pasos:</p>
          <p class="mt-1">Paso 1: Tus datos → Paso 2: El referido → Paso 3: Lo que busca</p>
        </div>

        <form id="referido-form" class="space-y-8">
          <fieldset class="space-y-4 rounded-xl border border-border p-4 md:p-5">
            <legend class="px-1 text-base font-semibold text-text-primary">Paso 1 · Tus datos</legend>
            <div class="grid gap-4 md:grid-cols-2">
              <div>
                <label for="referrerName" class="mb-1.5 block text-sm font-medium text-text-primary">Nombre del referidor</label>
                <input id="referrerName" name="referrerName" required class="w-full rounded-lg border border-border px-3 py-2.5 text-sm focus:border-secondary focus:outline-none" />
              </div>
              <div>
                <label for="referrerPhone" class="mb-1.5 block text-sm font-medium text-text-primary">Teléfono del referidor</label>
                <input id="referrerPhone" name="referrerPhone" type="tel" required class="w-full rounded-lg border border-border px-3 py-2.5 text-sm focus:border-secondary focus:outline-none" />
              </div>
            </div>
            <div class="grid gap-4 md:grid-cols-2">
              <div>
                <label for="referrerEmail" class="mb-1.5 block text-sm font-medium text-text-primary">Email del referidor (opcional)</label>
                <input id="referrerEmail" name="referrerEmail" type="email" class="w-full rounded-lg border border-border px-3 py-2.5 text-sm focus:border-secondary focus:outline-none" />
              </div>
              <div>
                <label for="relationship" class="mb-1.5 block text-sm font-medium text-text-primary">Relación con el referido</label>
                <select id="relationship" name="relationship" required class="w-full rounded-lg border border-border bg-white px-3 py-2.5 text-sm focus:border-secondary focus:outline-none">
                  <option value="">Selecciona una opción</option>
                  <option>Familiar</option>
                  <option>Amigo</option>
                  <option>Conocido</option>
                  <option>Colega</option>
                  <option>Cliente</option>
                  <option>Otro</option>
                </select>
              </div>
            </div>
          </fieldset>

          <fieldset class="space-y-4 rounded-xl border border-border p-4 md:p-5">
            <legend class="px-1 text-base font-semibold text-text-primary">Paso 2 · Datos del referido</legend>
            <div class="grid gap-4 md:grid-cols-2">
              <div>
                <label for="firstName" class="mb-1.5 block text-sm font-medium text-text-primary">Nombre del referido</label>
                <input id="firstName" name="firstName" required class="w-full rounded-lg border border-border px-3 py-2.5 text-sm focus:border-secondary focus:outline-none" />
              </div>
              <div>
                <label for="lastName" class="mb-1.5 block text-sm font-medium text-text-primary">Apellido del referido</label>
                <input id="lastName" name="lastName" required class="w-full rounded-lg border border-border px-3 py-2.5 text-sm focus:border-secondary focus:outline-none" />
              </div>
            </div>
            <div class="grid gap-4 md:grid-cols-2">
              <div>
                <label for="email" class="mb-1.5 block text-sm font-medium text-text-primary">Email del referido</label>
                <input id="email" name="email" type="email" required class="w-full rounded-lg border border-border px-3 py-2.5 text-sm focus:border-secondary focus:outline-none" />
              </div>
              <div>
                <label for="phone" class="mb-1.5 block text-sm font-medium text-text-primary">Teléfono del referido</label>
                <input id="phone" name="phone" type="tel" required class="w-full rounded-lg border border-border px-3 py-2.5 text-sm focus:border-secondary focus:outline-none" />
              </div>
            </div>
          </fieldset>

          <fieldset class="space-y-4 rounded-xl border border-border p-4 md:p-5">
            <legend class="px-1 text-base font-semibold text-text-primary">Paso 3 · Lo que busca</legend>
            <div class="grid gap-4 md:grid-cols-2">
              <div>
                <label for="interestType" class="mb-1.5 block text-sm font-medium text-text-primary">Tipo de interés</label>
                <select id="interestType" name="interestType" required class="w-full rounded-lg border border-border bg-white px-3 py-2.5 text-sm focus:border-secondary focus:outline-none">
                  <option value="">Selecciona una opción</option>
                  <option>Compra</option>
                  <option>Arriendo</option>
                  <option>Inversión en proyecto</option>
                </select>
              </div>
              <div>
                <label for="propertyType" class="mb-1.5 block text-sm font-medium text-text-primary">Tipo de inmueble</label>
                <select id="propertyType" name="propertyType" required class="w-full rounded-lg border border-border bg-white px-3 py-2.5 text-sm focus:border-secondary focus:outline-none">
                  <option value="">Selecciona una opción</option>
                  <option>Apartamento</option>
                  <option>Casa</option>
                  <option>Local</option>
                  <option>Oficina</option>
                  <option>Lote</option>
                  <option>Otro</option>
                </select>
              </div>
            </div>
            <div class="grid gap-4 md:grid-cols-2">
              <div>
                <label for="cityInterest" class="mb-1.5 block text-sm font-medium text-text-primary">Ciudad de interés</label>
                <input id="cityInterest" name="cityInterest" required class="w-full rounded-lg border border-border px-3 py-2.5 text-sm focus:border-secondary focus:outline-none" />
              </div>
              <div>
                <label for="budget" class="mb-1.5 block text-sm font-medium text-text-primary">Presupuesto aproximado (COP, opcional)</label>
                <input id="budget" name="budget" inputmode="numeric" placeholder="$ 350.000.000" class="w-full rounded-lg border border-border px-3 py-2.5 text-sm focus:border-secondary focus:outline-none" />
              </div>
            </div>
            <div>
              <label for="message" class="mb-1.5 block text-sm font-medium text-text-primary">Detalle adicional</label>
              <textarea id="message" name="message" rows="4" class="w-full rounded-lg border border-border px-3 py-2.5 text-sm focus:border-secondary focus:outline-none" placeholder="Ejemplo: ya tiene preaprobación bancaria y busca cerca de su trabajo."></textarea>
            </div>
          </fieldset>

          <button type="submit" id="submitBtn" class="btn-primary w-full">Enviar referido</button>
          <p id="referido-status" class="text-center text-sm text-text-secondary" aria-live="polite"></p>
        </form>
      </div>
    </div>
  </section>

  <section class="pb-12 lg:pb-16">
    <div class="container-custom">
      <div class="rounded-2xl border border-border bg-surface p-6 md:p-8">
        <div class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
          <div>
            <h2 class="font-heading text-2xl font-bold text-text-primary">Tu referido está en buenas manos</h2>
            <p class="mt-2 text-text-secondary">Acompañamos cada proceso con seguimiento personalizado y comunicación transparente.</p>
          </div>
          <div class="grid w-full max-w-xl grid-cols-1 gap-4 sm:grid-cols-3">
            <div class="rounded-xl border border-border bg-white p-4 text-center">
              <p class="text-2xl font-bold text-primary">+10</p>
              <p class="text-xs text-text-secondary">años de experiencia</p>
            </div>
            <div class="rounded-xl border border-border bg-white p-4 text-center">
              <p class="text-2xl font-bold text-primary">+1.200</p>
              <p class="text-xs text-text-secondary">propiedades gestionadas</p>
            </div>
            <div class="rounded-xl border border-border bg-white p-4 text-center">
              <p class="text-2xl font-bold text-primary">+900</p>
              <p class="text-xs text-text-secondary">clientes satisfechos</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="pb-16 lg:pb-20">
    <div class="container-custom">
      <div class="mx-auto max-w-3xl rounded-2xl border border-secondary/30 bg-secondary/10 p-6 text-center md:p-8">
        <h3 class="font-heading text-2xl font-bold text-text-primary">¿Prefieres hacerlo más rápido?</h3>
        <p class="mt-2 text-text-secondary">Escríbenos por WhatsApp y te ayudamos a registrar el referido en minutos.</p>
        <a
          href={`https://wa.me/${SITE_CONFIG.whatsapp}?text=${encodeURIComponent('Hola, quiero registrar un referido.')}`}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-5 inline-flex w-full items-center justify-center gap-2 rounded-lg bg-[#25D366] px-6 py-3 text-base font-semibold text-white transition-colors hover:bg-[#20bd5a] sm:w-auto"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-5 w-5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            set:html={iconPaths.Users}
          />
          Escribir por WhatsApp
        </a>
      </div>
    </div>
  </section>
</Layout>

<script>
  const form = document.getElementById('referido-form');
  const status = document.getElementById('referido-status');
  const submitBtn = document.getElementById('submitBtn');
  const budgetInput = document.getElementById('budget');

  const formatCOP = (value = '') => {
    const digits = String(value || '').replace(/\D/g, '');
    if (!digits) return '';
    return `$ ${Number(digits).toLocaleString('es-CO')}`;
  };

  if (budgetInput instanceof HTMLInputElement) {
    budgetInput.addEventListener('input', (event) => {
      const input = event.target;
      if (input instanceof HTMLInputElement) {
        input.value = formatCOP(input.value);
      }
    });
  }

  if (form instanceof HTMLFormElement) {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!(status instanceof HTMLElement)) return;

      status.textContent = 'Enviando referido...';
      if (submitBtn instanceof HTMLButtonElement) {
        submitBtn.setAttribute('disabled', 'true');
      }

      const formData = new FormData(form);
      const referralPhone = String(formData.get('phone') || '').replace(/\D/g, '');
      const interestType = String(formData.get('interestType') || '');
      const budgetDigits = String(formData.get('budget') || '').replace(/\D/g, '');

      const pipeline = interestType === 'Arriendo' ? 'renta' : 'compra';

      const referrerName = String(formData.get('referrerName') || '').trim();
      const referrerPhone = String(formData.get('referrerPhone') || '').trim();
      const referrerEmail = String(formData.get('referrerEmail') || '').trim();
      const relationship = String(formData.get('relationship') || '').trim();
      const detail = String(formData.get('message') || '').trim();

      const referrerExtras = referrerEmail ? `, ${referrerEmail}` : '';
      const notes = `Referido por: ${referrerName} (${referrerPhone}, ${relationship}${referrerExtras}). Detalle: ${detail || 'Sin detalle adicional.'}`;

      const payload = {
        firstName: String(formData.get('firstName') || '').trim(),
        lastName: String(formData.get('lastName') || '').trim(),
        email: String(formData.get('email') || '').trim(),
        phone: String(formData.get('phone') || '').trim(),
        source: 'referido',
        solicitud_type: 'Rentar o Comprar',
        sourceLink: '',
        pipeline,
        propertyType: String(formData.get('propertyType') || '').trim(),
        zone: String(formData.get('cityInterest') || '').trim(),
        budgetMax: budgetDigits ? Number(budgetDigits) : undefined,
        notes,
        idempotencyKey: `referral-${Date.now()}-${referralPhone || 'no-phone'}`,
      };

      try {
        const response = await fetch('/api/webhook/lead-intake', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(payload),
        });

        if (!response.ok) {
          throw new Error('No se pudo procesar el referido.');
        }

        status.textContent = '¡Gracias! Registramos tu referido correctamente.';
        form.reset();
      } catch {
        status.textContent = 'No pudimos enviar el formulario ahora. Inténtalo de nuevo o usa el botón de WhatsApp.';
      } finally {
        if (submitBtn instanceof HTMLButtonElement) {
          submitBtn.removeAttribute('disabled');
        }
      }
    });
  }
</script>
