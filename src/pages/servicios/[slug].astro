---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import { SERVICES, SITE_CONFIG } from '../../lib/constants';

type ServicePageContent = {
  subtitle: string;
  intro: string[];
  painTitle: string;
  painPoints: string[];
  solutionTitle: string;
  solutionPoints: string[];
  benefitsTitle: string;
  benefits: string[];
  ctaTitle: string;
  ctaText: string;
  ctaButton: string;
};

export async function getStaticPaths() {
  return SERVICES.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;

const breadcrumbItems = [
  { label: 'Inicio', href: '/' },
  { label: 'Servicios', href: '/servicios' },
  { label: service.title },
];

const serviceContent: Record<string, ServicePageContent> = {
  'creditos-hipotecarios': {
    subtitle: 'Intermediación con entidades financieras a nivel nacional',
    intro: [
      'La mayoría de personas no se acercan a un banco por falta de tiempo, desconocimiento del proceso o miedo a no tener perfil.',
      'En Invierta Inmobiliaria gestionamos tu crédito hipotecario, leasing habitacional o compra de cartera con acompañamiento de principio a fin.',
    ],
    painTitle: 'Lo que suele frenar el proceso',
    painPoints: [
      'No saber qué banco elegir.',
      'Pensar que el crédito es complicado o inalcanzable.',
      'No saber cómo estructurar el caso para aumentar probabilidades de aprobación.',
