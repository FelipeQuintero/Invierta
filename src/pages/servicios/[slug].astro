    painPoints: [
      'Pierdes propietarios y repetición del negocio.',
      'Dependes solo de comisiones grandes y esporádicas.',
      'El ciclo del cliente queda incompleto mientras espera una venta.',
    ],
    solutionTitle: 'Integra administración sin operarla',
    solutionPoints: [
      'Tú captas propietarios, negocias y cierras.',
      'Nosotros elaboramos y custodiamos contratos de administración.',
      'Gestionamos estudio de arrendatarios, cobro mensual, pago al propietario y procesos jurídicos en caso de incumplimiento.',
      'Incluimos reparaciones locativas con auditoría fotográfica y respaldo financiero al propietario.',
    ],
    benefitsTitle: 'Beneficios para agentes',
    benefits: [
      'COMISIÓN COMPLETA EN EL PRIMER PAGO POR LA COLOCACIÓN DEL CONTRATO DE ARRENDAMIENTO.',
      'Generas ingresos más rápidos (cierres en arrendamientos máximo 60 días).',
