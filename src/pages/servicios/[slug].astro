};

const content = serviceContent[service.slug];

const iconMap: Record<string, string> = {
  Users: 'M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M12 3a4 4 0 1 0 0 8 4 4 0 0 0 0-8zM22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75',
  Landmark: 'M3 22h18M6 18v-4M10 18v-4M14 18v-4M18 18v-4M3 10h18L12 3 3 10z',
  HandCoins: 'M11 15h2a2 2 0 1 0 0-4h-3c-.6 0-1.1.2-1.4.6L3 17M7 21l1.6-1.4c.3-.4.8-.6 1.4-.6h4c1.1 0 2.1-.4 2.8-1.2l4.6-4.4a2 2 0 0 0-2.75-2.91l-4.2 3.9M2 14l6 6M16 4a2 2 0 1 1 4 0v1.5a.5.5 0 0 0 .5.5.5.5 0 0 1 .5.5V8a.5.5 0 0 1-.5.5h-5A.5.5 0 0 1 15 8V6.5a.5.5 0 0 1 .5-.5.5.5 0 0 0 .5-.5V4z',
  TrendingDown: 'M22 17l-8.5-8.5-5 5L2 7M22 17h-6m6 0v-6',
  FileCheck: 'M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7zM14 2v5h5M9 15l2 2 4-4',
  Globe: 'M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20zM2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z',
};
---

<Layout title={`${service.title} | Invierta Inmobiliaria`} description={service.shortDescription}>
  <section class="bg-surface py-6">
    <div class="container-custom">
      <Breadcrumb items={breadcrumbItems} />
    </div>
  </section>

  <section class="py-12 lg:py-16">
    <div class="container-custom">
      <div class="mx-auto max-w-4xl">
        <div class="flex items-center gap-4">
          <div class="flex h-16 w-16 items-center justify-center rounded-xl bg-primary text-white">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d={iconMap[service.icon] || iconMap.FileCheck} />
            </svg>
          </div>
          <div>
            <h1 class="font-heading text-3xl font-bold text-text-primary lg:text-4xl">{service.title}</h1>
            <p class="mt-1 text-text-secondary">{content.subtitle}</p>
          </div>
        </div>

        <!-- Hero banner placeholder (F3-4) -->
        <div class="relative mt-8 mb-8 overflow-hidden rounded-2xl bg-gradient-to-r from-slate-100 to-slate-200 h-48 md:h-64 flex items-center justify-center">
          <div class="text-center text-slate-400">
            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="mx-auto mb-2"><rect width="18" height="18" x="3" y="3" rx="2"/><circle cx="12" cy="12" r="3"/><path d="m16 8-2 2"/></svg>
            <p class="text-sm">Banner o video del servicio (1920x600px recomendado)</p>
          </div>
        </div>

        <div class="space-y-4 text-lg leading-relaxed text-text-secondary">
          {content.intro.map((paragraph) => <p>{paragraph}</p>)}
        </div>

        <div class="mt-10 grid gap-6 lg:grid-cols-2">
          <article class="rounded-xl border border-border bg-white p-6 shadow-sm">
            <h2 class="font-heading text-xl font-semibold text-text-primary">{content.painTitle}</h2>
            <ul class="mt-4 space-y-3">
              {content.painPoints.map((point) => (
                <li class="flex items-start gap-3">
                  <svg xmlns="http://www.w3.org/2000/svg" class="mt-0.5 h-5 w-5 shrink-0 text-error" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M18 6 6 18" /><path d="m6 6 12 12" />
                  </svg>
                  <span class="text-text-secondary">{point}</span>
                </li>
              ))}
            </ul>
          </article>

          <article class="rounded-xl border border-border bg-white p-6 shadow-sm">
            <h2 class="font-heading text-xl font-semibold text-text-primary">{content.solutionTitle}</h2>
            <ul class="mt-4 space-y-3">
              {content.solutionPoints.map((point) => (
                <li class="flex items-start gap-3">
                  <svg xmlns="http://www.w3.org/2000/svg" class="mt-0.5 h-5 w-5 shrink-0 text-success" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20 6 9 17l-5-5" />
                  </svg>
                  <span class="text-text-secondary">{point}</span>
                </li>
              ))}
            </ul>
          </article>
        </div>

        <article class="mt-6 rounded-xl border border-border bg-white p-6 shadow-sm">
          <h2 class="font-heading text-xl font-semibold text-text-primary">{content.benefitsTitle}</h2>
          <ul class="mt-4 grid gap-3 sm:grid-cols-2">
            {content.benefits.map((benefit) => (
              <li class="flex items-start gap-3">
                <svg xmlns="http://www.w3.org/2000/svg" class="mt-0.5 h-5 w-5 shrink-0 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M20 6 9 17l-5-5" />
                </svg>
                <span class="text-text-secondary">{benefit}</span>
              </li>
            ))}
          </ul>
        </article>
      </div>
    </div>
  </section>

  <!-- Contact Form Section -->
  <section class="py-12 bg-surface" id="contacto-servicio">
    <div class="mx-auto max-w-xl px-4">
      <h2 class="text-center font-heading text-2xl font-bold text-text-primary mb-2">¿Te interesa este servicio?</h2>
      <p class="text-center text-text-secondary mb-8">Déjanos tus datos y un asesor especializado te contactará</p>
      <form id="servicio-form" data-service={service.title} class="space-y-4 bg-white rounded-xl border border-border p-6 shadow-sm">
        <div>
          <label for="srv-nombre" class="block text-sm font-medium text-text-secondary mb-1">Nombre completo</label>
          <input type="text" id="srv-nombre" name="firstName" required class="w-full rounded-lg border border-border px-4 py-3 text-text-primary focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20" placeholder="Tu nombre">
        </div>
        <div>
          <label for="srv-celular" class="block text-sm font-medium text-text-secondary mb-1">Celular</label>
          <input type="tel" id="srv-celular" name="phone" required class="w-full rounded-lg border border-border px-4 py-3 text-text-primary focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20" placeholder="Ej: 312 248 2337">
        </div>
        <div>
          <label for="srv-correo" class="block text-sm font-medium text-text-secondary mb-1">Correo electrónico</label>
          <input type="email" id="srv-correo" name="email" required class="w-full rounded-lg border border-border px-4 py-3 text-text-primary focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20" placeholder="tu@correo.com">
        </div>
        <button type="submit" class="w-full rounded-lg bg-accent py-3 text-white font-semibold hover:bg-accent/90 transition-colors shadow-md">
          Solicitar información
        </button>
        <p id="srv-form-message" class="text-center text-sm hidden"></p>
      </form>
    </div>
  </section>

  <!-- CTA Section (F1-3: high-visibility design) -->
  <section class="relative bg-gradient-to-br from-accent/10 via-white to-accent/5 py-16 border-t-4 border-accent shadow-[0_-4px_20px_rgba(249,115,22,0.12)]">
    <div class="container-custom">
      <div class="mx-auto max-w-3xl text-center">
        <span class="inline-block rounded-full bg-accent/15 px-4 py-1.5 text-sm font-semibold text-accent mb-4">No te quedes con la duda</span>
        <h2 class="font-heading text-2xl font-bold text-text-primary lg:text-3xl">{content.ctaTitle}</h2>
        <p class="mt-4 text-text-secondary text-lg">{content.ctaText}</p>
        <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
          <button
            type="button"
            onclick="document.getElementById('contacto-servicio').scrollIntoView({behavior:'smooth'})"
            class="inline-flex items-center gap-2 rounded-xl bg-accent px-8 py-4 text-lg font-bold text-white shadow-lg shadow-accent/30 transition-all hover:bg-accent-dark hover:shadow-xl hover:shadow-accent/40 hover:-translate-y-0.5 cursor-pointer"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
            {content.ctaButton}
          </button>
          <a
            href={`https://wa.me/${SITE_CONFIG.whatsapp}?text=${encodeURIComponent(`Hola, me interesa el servicio de ${service.title}`)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-xl border-2 border-accent px-8 py-4 text-lg font-bold text-accent transition-all hover:bg-accent hover:text-white hover:-translate-y-0.5"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            Escribir por WhatsApp
          </a>
        </div>
      </div>
    </div>
  </section>

  <script>
    document.getElementById('servicio-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const form = e.target as HTMLFormElement;
      const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      const msg = document.getElementById('srv-form-message')!;
      const serviceTitle = form.dataset.service || '';

      btn.disabled = true;
      btn.textContent = 'Enviando...';

      const data = {
        firstName: (form.elements.namedItem('firstName') as HTMLInputElement).value,
        phone: (form.elements.namedItem('phone') as HTMLInputElement).value,
        email: (form.elements.namedItem('email') as HTMLInputElement).value,
        source: 'Servicio: ' + serviceTitle,
      };

      try {
        const webhookUrl = 'https://services.leadconnectorhq.com/hooks/8kbdbM2PqR4rZqVDL126/webhook-trigger/a380a512-3b67-4cc6-b639-86d3aacfdccf';
        await fetch(webhookUrl, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });
        msg.textContent = '¡Gracias! Un asesor te contactará pronto.';
        msg.className = 'text-center text-sm text-green-600 mt-2';
        form.reset();
      } catch (err) {
        msg.textContent = 'Error al enviar. Intenta de nuevo.';
        msg.className = 'text-center text-sm text-red-500 mt-2';
      } finally {
        btn.disabled = false;
        btn.textContent = 'Solicitar información';
      }
    });
  </script>
</Layout>
