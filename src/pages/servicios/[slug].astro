    ],
    benefitsTitle: 'Opciones de financiación',
    benefits: [
      'Financiación hasta el 80 % del valor de la vivienda.',
      'Plazos flexibles de 5 a 30 años.',
      'Preaprobación aproximada en 48 horas.',
      'Proceso virtual, ágil y con acompañamiento personalizado.',
    ],
