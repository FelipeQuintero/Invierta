---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import { SERVICES, SITE_CONFIG } from '../../lib/constants';

export async function getStaticPaths() {
  return SERVICES.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;

const breadcrumbItems = [
  { label: 'Inicio', href: '/' },
  { label: 'Servicios', href: '/servicios' },
  { label: service.title },
];

const serviceContent: Record<string, { description: string; benefits: string[]; cta: string }> = {
  'agentes-inmobiliarios': {
    description: 'Contamos con una red de agentes inmobiliarios profesionales certificados, listos para acompanarte en cada paso del proceso de compra, venta o arriendo de tu propiedad. Nuestros asesores conocen a fondo el mercado local y te brindaran atencion personalizada para encontrar la mejor opcion segun tus necesidades y presupuesto.',
    benefits: [
      'Asesoria personalizada durante todo el proceso',
      'Conocimiento experto del mercado inmobiliario local',
      'Negociacion profesional para obtener el mejor precio',
      'Acompanamiento en tramites legales y documentacion',
      'Amplia red de contactos y propiedades exclusivas',
      'Disponibilidad para visitas y consultas',
    ],
    cta: 'Conecta con un asesor',
  },
  'creditos-hipotecarios': {
    description: 'Te conectamos con las mejores entidades financieras para que obtengas el credito hipotecario que necesitas. Analizamos tu perfil crediticio y te presentamos opciones personalizadas con tasas competitivas. Nuestro equipo te acompana durante todo el proceso de solicitud y aprobacion.',
    benefits: [
      'Comparacion de tasas entre multiples entidades',
      'Asesoria en requisitos y documentacion',
      'Simulacion de cuotas y plazos',
      'Acompanamiento en el proceso de aprobacion',
      'Opciones para diferentes perfiles crediticios',
      'Sin costo adicional por nuestra asesoria',
    ],
    cta: 'Solicitar asesoria de credito',
  },
  'prestamos-hipotecas': {
    description: 'Obtén liquidez inmediata utilizando tu propiedad como garantia. Los prestamos sobre hipotecas te permiten acceder a capital sin necesidad de vender tu inmueble. Ideal para inversiones, consolidacion de deudas o proyectos personales con tasas mas favorables que un credito de libre inversion.',
    benefits: [
      'Tasas de interes mas bajas que creditos de consumo',
      'Plazos flexibles de pago',
      'Mantén la propiedad de tu inmueble',
      'Montos significativos segun el avaluo',
      'Proceso agil y transparente',
      'Asesoria completa sobre condiciones',
    ],
    cta: 'Conocer opciones de prestamo',
  },
  'reduccion-creditos': {
    description: 'Si ya tienes un credito hipotecario, podemos ayudarte a mejorar sus condiciones. Evaluamos tu situacion actual y negociamos con entidades financieras para reducir tu tasa de interes, ajustar plazos o unificar deudas. Ahorrar en el pago mensual de tu hipoteca es posible.',
    benefits: [
      'Reduccion de tasa de interes',
      'Ajuste de plazos segun tu capacidad',
      'Unificacion de multiples creditos',
      'Ahorro significativo en intereses totales',
      'Sin penalizaciones ocultas',
      'Proceso gestionado integramente por nosotros',
    ],
    cta: 'Evaluar mi credito actual',
  },
  'avaluos': {
    description: 'Conoce el valor real de tu propiedad con avaluos certificados realizados por profesionales acreditados. Nuestros avaluos cumplen con todos los requisitos legales y bancarios, siendo validos para tramites de credito, compraventa, sucesiones y procesos juridicos.',
    benefits: [
      'Avaluadores certificados y con experiencia',
      'Informe detallado y profesional',
      'Valido para tramites bancarios y legales',
      'Visita presencial al inmueble',
      'Entrega rapida del informe',
      'Precios competitivos',
    ],
    cta: 'Solicitar avaluo',
  },
  'monetizacion-exterior': {
    description: 'Si eres colombiano en el exterior y deseas invertir en finca raiz en Colombia, te ofrecemos un servicio integral. Desde la busqueda de la propiedad ideal hasta la gestion de arrendamiento y administracion, nos encargamos de todo para que puedas invertir con tranquilidad desde cualquier parte del mundo.',
    benefits: [
      'Busqueda personalizada de propiedades',
      'Visitas virtuales y documentacion digital',
      'Gestion de compra a distancia',
      'Administracion de arriendos',
      'Reportes periodicos de tu inversion',
      'Atencion en tu zona horaria',
    ],
    cta: 'Invertir desde el exterior',
  },
};

const content = serviceContent[service.slug] || {
  description: service.shortDescription,
  benefits: ['Asesoria profesional', 'Atencion personalizada', 'Resultados garantizados'],
  cta: 'Contactar',
};

const iconMap: Record<string, string> = {
  Users: 'M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M12 3a4 4 0 1 0 0 8 4 4 0 0 0 0-8zM22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75',
  Landmark: 'M3 22h18M6 18v-4M10 18v-4M14 18v-4M18 18v-4M3 10h18L12 3 3 10z',
  HandCoins: 'M11 15h2a2 2 0 1 0 0-4h-3c-.6 0-1.1.2-1.4.6L3 17M7 21l1.6-1.4c.3-.4.8-.6 1.4-.6h4c1.1 0 2.1-.4 2.8-1.2l4.6-4.4a2 2 0 0 0-2.75-2.91l-4.2 3.9M2 14l6 6M16 4a2 2 0 1 1 4 0v1.5a.5.5 0 0 0 .5.5.5.5 0 0 1 .5.5V8a.5.5 0 0 1-.5.5h-5A.5.5 0 0 1 15 8V6.5a.5.5 0 0 1 .5-.5.5.5 0 0 0 .5-.5V4z',
  TrendingDown: 'M22 17l-8.5-8.5-5 5L2 7M22 17h-6m6 0v-6',
  FileCheck: 'M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7zM14 2v5h5M9 15l2 2 4-4',
  Globe: 'M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20zM2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z',
};
---

<Layout
  title={`${service.title} | Invierta Inmobiliaria`}
  description={service.shortDescription}
>
  <section class="bg-surface py-6">
    <div class="container-custom">
      <Breadcrumb items={breadcrumbItems} />
    </div>
  </section>

  <section class="py-12 lg:py-16">
    <div class="container-custom">
      <div class="lg:flex lg:gap-12">
        <div class="flex-1">
          <div class="flex items-center gap-4">
            <div class="flex h-16 w-16 items-center justify-center rounded-xl bg-primary text-white">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-8 w-8"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d={iconMap[service.icon] || iconMap.FileCheck} />
              </svg>
            </div>
            <h1 class="font-heading text-3xl font-bold text-text-primary lg:text-4xl">
              {service.title}
            </h1>
          </div>

          <p class="mt-6 text-lg leading-relaxed text-text-secondary">
            {content.description}
          </p>

          <div class="mt-10">
            <h2 class="font-heading text-xl font-semibold text-text-primary">
              Beneficios del servicio
            </h2>
            <ul class="mt-4 space-y-3">
              {content.benefits.map((benefit) => (
                <li class="flex items-start gap-3">
                  <svg xmlns="http://www.w3.org/2000/svg" class="mt-0.5 h-5 w-5 shrink-0 text-success" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20 6 9 17l-5-5"/>
                  </svg>
                  <span class="text-text-secondary">{benefit}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <aside class="mt-10 lg:mt-0 lg:w-96 lg:shrink-0">
          <div class="sticky top-24 rounded-xl border border-border bg-white p-6 shadow-sm">
            <h3 class="font-heading text-lg font-semibold text-text-primary">
              Solicitar este servicio
            </h3>
            <p class="mt-2 text-sm text-text-secondary">
              Completa el formulario o contactanos directamente. Te responderemos en menos de 24 horas.
            </p>

            <form class="mt-6 space-y-4">
              <div>
                <label for="name" class="block text-sm font-medium text-text-primary">
                  Nombre completo
                </label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  class="mt-1 w-full rounded-lg border border-border bg-white px-4 py-2.5 text-text-primary placeholder:text-text-muted focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
                  placeholder="Tu nombre"
                />
              </div>
              <div>
                <label for="email" class="block text-sm font-medium text-text-primary">
                  Correo electronico
                </label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  class="mt-1 w-full rounded-lg border border-border bg-white px-4 py-2.5 text-text-primary placeholder:text-text-muted focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
                  placeholder="tu@email.com"
                />
              </div>
              <div>
                <label for="phone" class="block text-sm font-medium text-text-primary">
                  Telefono / WhatsApp
                </label>
                <input
                  type="tel"
                  id="phone"
                  name="phone"
                  required
                  class="mt-1 w-full rounded-lg border border-border bg-white px-4 py-2.5 text-text-primary placeholder:text-text-muted focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
                  placeholder="300 123 4567"
                />
              </div>
              <div>
                <label for="message" class="block text-sm font-medium text-text-primary">
                  Mensaje (opcional)
                </label>
                <textarea
                  id="message"
                  name="message"
                  rows="3"
                  class="mt-1 w-full rounded-lg border border-border bg-white px-4 py-2.5 text-text-primary placeholder:text-text-muted focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary resize-none"
                  placeholder="Cuentanos mas sobre lo que necesitas..."
                ></textarea>
              </div>
              <button
                type="submit"
                class="btn-primary w-full"
              >
                {content.cta}
              </button>
            </form>

            <div class="mt-6 border-t border-border pt-6">
              <p class="text-center text-sm text-text-muted">O contactanos directamente</p>
              <div class="mt-4 flex flex-col gap-3">
                <a
                  href={`https://wa.me/${SITE_CONFIG.whatsapp}?text=${encodeURIComponent(`Hola, me interesa el servicio de ${service.title}`)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center justify-center gap-2 rounded-lg bg-[#25D366] px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-[#20bd5a]"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/>
                  </svg>
                  WhatsApp
                </a>
                <a
                  href={`tel:${SITE_CONFIG.phone}`}
                  class="flex items-center justify-center gap-2 rounded-lg border border-border px-4 py-2.5 text-sm font-semibold text-text-primary transition-colors hover:bg-surface"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                  </svg>
                  {SITE_CONFIG.phone}
                </a>
              </div>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <section class="bg-surface py-12">
    <div class="container-custom">
      <h2 class="font-heading text-2xl font-bold text-text-primary text-center">
        Otros servicios
      </h2>
      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {SERVICES.filter(s => s.slug !== service.slug).slice(0, 3).map((otherService) => (
          <a
            href={`/servicios/${otherService.slug}`}
            class="flex items-center gap-4 rounded-lg border border-border bg-white p-4 transition-all hover:border-primary/30 hover:shadow-sm"
          >
            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-lg bg-primary/10 text-primary">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-6 w-6"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d={iconMap[otherService.icon] || iconMap.FileCheck} />
              </svg>
            </div>
            <div>
              <h3 class="font-medium text-text-primary">{otherService.title}</h3>
              <p class="text-sm text-text-muted line-clamp-1">{otherService.shortDescription}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
