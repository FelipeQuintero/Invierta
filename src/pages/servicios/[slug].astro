---

<Layout title={`${service.title} | Invierta Inmobiliaria`} description={service.shortDescription}>
  <section class="bg-surface py-6">
    <div class="container-custom">
      <Breadcrumb items={breadcrumbItems} />
    </div>
  </section>

  <section class="py-12 lg:py-16">
    <div class="container-custom">
      <div class="mx-auto max-w-4xl">
        <div class="flex items-center gap-4">
          <div class="flex h-16 w-16 items-center justify-center rounded-xl bg-primary text-white">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d={iconMap[service.icon] || iconMap.FileCheck} />
            </svg>
          </div>
          <div>
            <h1 class="font-heading text-3xl font-bold text-text-primary lg:text-4xl">{service.title}</h1>
            <p class="mt-1 text-text-secondary">{content.subtitle}</p>
          </div>
        </div>

        <div class="mt-8 space-y-4 text-lg leading-relaxed text-text-secondary">
          {content.intro.map((paragraph) => <p>{paragraph}</p>)}
        </div>

        <div class="mt-10 grid gap-6 lg:grid-cols-2">
          <article class="rounded-xl border border-border bg-white p-6 shadow-sm">
            <h2 class="font-heading text-xl font-semibold text-text-primary">{content.painTitle}</h2>
            <ul class="mt-4 space-y-3">
              {content.painPoints.map((point) => (
                <li class="flex items-start gap-3">
                  <span class="mt-1 block h-2 w-2 rounded-full bg-danger"></span>
                  <span class="text-text-secondary">{point}</span>
                </li>
              ))}
            </ul>
          </article>

          <article class="rounded-xl border border-border bg-white p-6 shadow-sm">
            <h2 class="font-heading text-xl font-semibold text-text-primary">{content.solutionTitle}</h2>
            <ul class="mt-4 space-y-3">
              {content.solutionPoints.map((point) => (
                <li class="flex items-start gap-3">
                  <svg xmlns="http://www.w3.org/2000/svg" class="mt-0.5 h-5 w-5 shrink-0 text-success" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20 6 9 17l-5-5" />
                  </svg>
                  <span class="text-text-secondary">{point}</span>
                </li>
              ))}
            </ul>
          </article>
        </div>

        <article class="mt-6 rounded-xl border border-border bg-white p-6 shadow-sm">
          <h2 class="font-heading text-xl font-semibold text-text-primary">{content.benefitsTitle}</h2>
          <ul class="mt-4 grid gap-3 sm:grid-cols-2">
            {content.benefits.map((benefit) => (
              <li class="flex items-start gap-3">
                <svg xmlns="http://www.w3.org/2000/svg" class="mt-0.5 h-5 w-5 shrink-0 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M20 6 9 17l-5-5" />
                </svg>
                <span class="text-text-secondary">{benefit}</span>
              </li>
            ))}
          </ul>
        </article>
      </div>
    </div>
  </section>

  <section class="bg-primary py-14">
    <div class="container-custom">
      <div class="mx-auto max-w-3xl text-center">
        <h2 class="font-heading text-2xl font-bold text-white lg:text-3xl">{content.ctaTitle}</h2>
        <p class="mt-4 text-white/85">{content.ctaText}</p>
        <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
          <a
            href={`https://wa.me/${SITE_CONFIG.whatsapp}?text=${encodeURIComponent(`Hola, me interesa el servicio de ${service.title}`)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-lg bg-[#25D366] px-6 py-3 font-semibold text-white transition-colors hover:bg-[#20bd5a]"
          >
            {content.ctaButton}
          </a>
          <a href={`tel:${SITE_CONFIG.phone}`} class="inline-flex items-center gap-2 rounded-lg border-2 border-white px-6 py-3 font-semibold text-white transition-colors hover:bg-white hover:text-primary">
            Llamar ahora
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
