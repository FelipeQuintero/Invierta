---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import { SITE_CONFIG } from '../../lib/constants';

const breadcrumbItems = [
  { label: 'Inicio', href: '/' },
  { label: 'Publica tu Inmueble', href: '/publica' },
  { label: 'Arriendo' },
];

const whatsappUrl = `https://wa.me/${SITE_CONFIG.whatsapp}?text=${encodeURIComponent('Hola, me interesa publicar mi inmueble en arriendo.')}`;
---

<Layout
  title="Publica tu Inmueble en Arriendo | Invierta Inmobiliaria"
  description="Arrienda tu propiedad con Invierta Inmobiliaria. Gestion integral, inquilinos verificados y acompanamiento profesional."
>
  <section class="bg-surface py-6">
    <div class="container-custom">
      <Breadcrumb items={breadcrumbItems} />
    </div>
  </section>

  <section class="py-12 lg:py-20">
    <div class="container-custom">
      <div class="mx-auto max-w-3xl text-center">
        <div class="mb-6 mx-auto flex h-20 w-20 items-center justify-center rounded-2xl bg-secondary/10 text-secondary">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="7" width="20" height="14" rx="2" ry="2" />
            <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16" />
          </svg>
        </div>
        <h1 class="font-heading text-3xl font-bold text-text-primary lg:text-4xl">
          Publica tu Inmueble en Arriendo
        </h1>
        <p class="mt-4 text-lg text-text-secondary max-w-2xl mx-auto">
          En {SITE_CONFIG.name} nos encargamos de todo el proceso para que arriendas tu propiedad de forma segura y sin complicaciones.
        </p>
      </div>

      <div class="mx-auto mt-12 max-w-2xl grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        <div class="flex flex-col items-center text-center p-6 rounded-xl bg-white border border-border shadow-sm">
          <div class="flex h-12 w-12 items-center justify-center rounded-full bg-secondary/10 text-secondary mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
              <circle cx="9" cy="7" r="4"/>
              <path d="M22 21v-2a4 4 0 0 0-3-3.87"/>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
            </svg>
          </div>
          <h3 class="font-semibold text-text-primary">Inquilinos Verificados</h3>
          <p class="mt-2 text-sm text-text-secondary">Verificamos referencias y capacidad de pago de cada candidato.</p>
        </div>
        <div class="flex flex-col items-center text-center p-6 rounded-xl bg-white border border-border shadow-sm">
          <div class="flex h-12 w-12 items-center justify-center rounded-full bg-secondary/10 text-secondary mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            </svg>
          </div>
          <h3 class="font-semibold text-text-primary">Gestion Segura</h3>
          <p class="mt-2 text-sm text-text-secondary">Contratos legales, seguros y acompanamiento juridico permanente.</p>
        </div>
        <div class="flex flex-col items-center text-center p-6 rounded-xl bg-white border border-border shadow-sm sm:col-span-2 lg:col-span-1">
          <div class="flex h-12 w-12 items-center justify-center rounded-full bg-secondary/10 text-secondary mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="12" y1="1" x2="12" y2="23"/>
              <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
            </svg>
          </div>
          <h3 class="font-semibold text-text-primary">Pagos Puntuales</h3>
          <p class="mt-2 text-sm text-text-secondary">Recibe tus pagos de arriendo de forma oportuna cada mes.</p>
        </div>
      </div>

      <div class="mx-auto mt-12 max-w-xl text-center">
        <p class="text-text-secondary mb-6">
          Contactanos para comenzar el proceso de publicacion de tu inmueble en arriendo.
        </p>
        <div class="flex flex-col items-center justify-center gap-4 sm:flex-row">
          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-lg bg-[#25D366] px-6 py-3 font-semibold text-white transition-colors hover:bg-[#20bd5a]"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/>
            </svg>
            Escribir por WhatsApp
          </a>
          <a
            href={`tel:${SITE_CONFIG.phone}`}
            class="inline-flex items-center gap-2 rounded-lg border-2 border-primary px-6 py-3 font-semibold text-primary transition-colors hover:bg-primary hover:text-white"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
            Llamar ahora
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
