---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import { SITE_CONFIG } from '../../lib/constants';

const breadcrumbItems = [
  { label: 'Inicio', href: '/' },
  { label: 'Publica tu Inmueble' },
];
---

<Layout
  title="Publica tu Inmueble | Invierta Inmobiliaria"
  description="Publica tu propiedad en venta o arriendo con Invierta Inmobiliaria. Llegamos a miles de compradores e inquilinos potenciales."
>
  <section class="bg-surface py-6">
    <div class="container-custom">
      <Breadcrumb items={breadcrumbItems} />
    </div>
  </section>

  <section class="py-12 lg:py-20">
    <div class="container-custom">
      <div class="mx-auto max-w-3xl text-center mb-10 lg:mb-14">
        <h1 class="font-heading text-3xl font-bold text-text-primary lg:text-4xl">
          Publica tu Inmueble
        </h1>
        <p class="mt-4 text-lg text-text-secondary">
          Selecciona el tipo de publicacion que necesitas. En {SITE_CONFIG.name} te ayudamos a conectar con compradores e inquilinos de forma rapida y segura.
        </p>
      </div>

      <div class="mx-auto max-w-4xl grid gap-6 sm:grid-cols-2">
        <!-- Publicar en Venta -->
        <a
          href="/servicios"
          class="group relative flex flex-col items-center overflow-hidden rounded-2xl border border-border bg-white p-8 lg:p-10 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-primary/30"
        >
          <div class="mb-6 flex h-20 w-20 items-center justify-center rounded-2xl bg-primary/10 text-primary transition-colors group-hover:bg-primary group-hover:text-white">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
              <polyline points="9 22 9 12 15 12 15 22" />
            </svg>
          </div>
          <h2 class="font-heading text-xl font-bold text-text-primary group-hover:text-primary transition-colors">
            Publicar en Venta
          </h2>
          <p class="mt-3 text-center text-text-secondary text-sm leading-relaxed">
            Vende tu propiedad con el respaldo de nuestro equipo de expertos. Avaluos, asesoria legal y promocion incluida.
          </p>
          <span class="mt-6 inline-flex items-center gap-1.5 text-sm font-semibold text-primary">
            Comenzar
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m9 18 6-6-6-6"/>
            </svg>
          </span>
        </a>

        <!-- Publicar en Arriendo -->
        <a
          href="/publica/arriendo"
          class="group relative flex flex-col items-center overflow-hidden rounded-2xl border border-border bg-white p-8 lg:p-10 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-secondary/30"
        >
          <div class="mb-6 flex h-20 w-20 items-center justify-center rounded-2xl bg-secondary/10 text-secondary transition-colors group-hover:bg-secondary group-hover:text-white">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="7" width="20" height="14" rx="2" ry="2" />
              <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16" />
            </svg>
          </div>
          <h2 class="font-heading text-xl font-bold text-text-primary group-hover:text-secondary transition-colors">
            Publicar en Arriendo
          </h2>
          <p class="mt-3 text-center text-text-secondary text-sm leading-relaxed">
            Arrienda tu inmueble de forma segura. Nos encargamos de encontrar al inquilino ideal y gestionar todo el proceso.
          </p>
          <span class="mt-6 inline-flex items-center gap-1.5 text-sm font-semibold text-secondary">
            Comenzar
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m9 18 6-6-6-6"/>
            </svg>
          </span>
        </a>
      </div>
    </div>
  </section>
</Layout>
