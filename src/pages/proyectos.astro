---
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/ui/Breadcrumb.astro';
import ProjectFilters from '../components/projects/ProjectFilters.tsx';
import type { Project } from '../components/projects/types';

export const prerender = false;

const apiUrl = new URL('/api/projects', Astro.url);
let projects: Project[] = [];

try {
  const response = await fetch(apiUrl);
  if (response.ok) {
    const data = await response.json();
    projects = Array.isArray(data) ? data : data?.projects || [];
  }
} catch (error) {
  console.error('Error cargando proyectos:', error);
}

projects = projects.filter((project) => project?.isActive !== false);

const breadcrumbItems = [
  { label: 'Inicio', href: '/' },
  { label: 'Proyectos Nuevos' },
];
---

<Layout
  title="Proyectos Nuevos sobre Planos | Invierta Inmobiliaria"
  description="Conoce proyectos inmobiliarios nuevos en preventa, construcción y entrega inmediata en Colombia."
>
  <section class="bg-surface py-6">
    <div class="container-custom">
      <Breadcrumb items={breadcrumbItems} />
    </div>
  </section>

  <section class="py-6 lg:py-8">
    <div class="container-custom">
      <div class="mb-6">
        <h1 class="font-heading text-3xl font-bold text-text-primary lg:text-4xl">Proyectos Nuevos</h1>
        <p class="mt-2 text-text-secondary">
          Invierte desde planos con proyectos seleccionados en preventa, construcción y entrega inmediata.
        </p>
      </div>

      <ProjectFilters client:load projects={projects} />
    </div>
  </section>
</Layout>
