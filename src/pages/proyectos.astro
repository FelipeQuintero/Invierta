---
import Layout from '../layouts/Layout.astro';
import PropertyGrid from '../components/properties/PropertyGrid.astro';
import PropertyFilters from '../components/properties/PropertyFilters.tsx';
import Breadcrumb from '../components/ui/Breadcrumb.astro';
import { getProperties } from '../lib/simi';

const properties = await getProperties({ operation: 'proyecto', limit: 12 });

const breadcrumbItems = [
  { label: 'Inicio', href: '/' },
  { label: 'Proyectos Nuevos' },
];
---

<Layout
  title="Proyectos Nuevos sobre Planos | Invierta Inmobiliaria"
  description="Invierte en proyectos nuevos sobre planos. Apartamentos y casas en construccion con precios de preventa."
>
  <section class="bg-surface py-6">
    <div class="container-custom">
      <Breadcrumb items={breadcrumbItems} />
    </div>
  </section>

  <section class="py-8 lg:py-12">
    <div class="container-custom">
      <div class="mb-8">
        <h1 class="font-heading text-3xl font-bold text-text-primary lg:text-4xl">
          Proyectos Nuevos
        </h1>
        <p class="mt-2 text-text-secondary">
          Descubre proyectos sobre planos y en construccion. Invierte desde el inicio con precios de preventa.
        </p>
      </div>

      <div class="lg:flex lg:gap-8">
        <aside class="mb-6 lg:mb-0 lg:w-72 lg:shrink-0">
          <PropertyFilters client:load operation="proyecto" />
        </aside>

        <div class="flex-1">
          <div class="mb-4 flex items-center justify-between">
            <p class="text-sm text-text-secondary">
              <span class="font-semibold text-text-primary">{properties.length}</span> proyectos encontrados
            </p>
            <select
              class="rounded-lg border border-border bg-white px-3 py-2 text-sm text-text-primary focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
            >
              <option value="recent">Mas recientes</option>
              <option value="price-asc">Menor precio</option>
              <option value="price-desc">Mayor precio</option>
            </select>
          </div>

          <PropertyGrid properties={properties} />

          {properties.length >= 12 && (
            <div class="mt-8 flex justify-center">
              <button class="btn-outline">
                Cargar mas proyectos
              </button>
            </div>
          )}
        </div>
      </div>
    </div>
  </section>
</Layout>
