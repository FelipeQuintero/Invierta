---
import type { PropertyTag } from '../../lib/types';
import { getTagLabel, getTagColor } from '../../lib/utils';

interface Props {
  tag: PropertyTag;
  size?: 'sm' | 'md';
}

const { tag, size = 'sm' } = Astro.props;

const label = getTagLabel(tag);
const colorClasses = getTagColor(tag);

const sizeClasses = size === 'sm'
  ? 'px-2 py-0.5 text-xs'
  : 'px-3 py-1 text-sm';
---

<span
  class:list={[
    'inline-block rounded-full font-semibold leading-tight whitespace-nowrap',
    sizeClasses,
    colorClasses,
  ]}
>
  {label}
</span>
