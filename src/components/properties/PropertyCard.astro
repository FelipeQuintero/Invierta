---
import type { PropertyTag, PropertyType, OperationType } from '../../lib/types';
import { formatPrice, getPropertyUrl, getTagLabel, getTagColor } from '../../lib/utils';
import { PROPERTY_TYPES } from '../../lib/constants';

interface Props {
  id: string;
  title: string;
  image: string;
  images?: string[];
  price: number;
  priceType: 'venta' | 'arriendo';
  operationType?: OperationType;
  location: string;
  area: number;
  bedrooms: number;
  bathrooms: number;
  parking?: number;
  adminFee?: number;
  tags: PropertyTag[];
  propertyType: PropertyType;
}

const {
  id,
  title,
  image,
  images = [],
  price,
  priceType,
  operationType,
  location,
  area,
  bedrooms,
  bathrooms,
  parking = 0,
  adminFee,
  tags,
  propertyType,
} = Astro.props;

const propertyTypeLabel =
  PROPERTY_TYPES.find((pt) => pt.value === propertyType)?.label || propertyType;

const formattedPrice = formatPrice(price);
const propertyUrl = getPropertyUrl(id);
const imageCount = images.length > 0 ? images.length : 1;

function getOperationBadge(op?: OperationType | 'venta' | 'arriendo') {
  const resolved = op || priceType;
  switch (resolved) {
    case 'venta': return { label: 'En Venta', cls: 'bg-emerald-600 text-white' };
    case 'arriendo': return { label: 'En Arriendo', cls: 'bg-blue-600 text-white' };
    case 'proyecto': return { label: 'Proyecto', cls: 'bg-purple-600 text-white' };
    default: return null;
  }
}

const opBadge = getOperationBadge(operationType);
---

<a
  href={propertyUrl}
  class="group flex flex-col bg-white rounded-xl overflow-hidden shadow-md hover:shadow-xl transition-all duration-200 cursor-pointer"
>
  <div class="relative aspect-[4/3] overflow-hidden">
    <img
      src={image}
      alt={title}
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
      loading="lazy"
    />

    {opBadge && (
      <div class="absolute top-3 left-3">
        <span class:list={['inline-block px-2.5 py-1 text-xs font-bold rounded-md shadow-sm', opBadge.cls]}>
          {opBadge.label}
        </span>
      </div>
    )}

    <div class="absolute top-3 right-3 flex items-center gap-1.5">
      {tags.length > 0 && (
        <div class="flex flex-wrap gap-1.5">
          {tags.map((tag) => (
            <span class:list={['inline-block px-2 py-0.5 text-xs font-semibold rounded-full shadow-sm', getTagColor(tag)]}>
              {getTagLabel(tag)}
            </span>
          ))}
        </div>
      )}
      <span
        class="flex items-center justify-center w-8 h-8 rounded-full bg-white/80 backdrop-blur-sm shadow-sm"
        aria-label="Guardar en favoritos"
      >
        <svg class="w-4 h-4 text-gray-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z" />
        </svg>
      </span>
    </div>

    {imageCount > 1 && (
      <div class="absolute bottom-2.5 left-1/2 -translate-x-1/2 flex items-center gap-1.5">
        {Array.from({ length: Math.min(imageCount, 5) }).map((_, i) => (
          <span class:list={['block w-1.5 h-1.5 rounded-full', i === 0 ? 'bg-white' : 'bg-white/50']} />
        ))}
        {imageCount > 5 && (
          <span class="text-white text-[10px] font-medium ml-0.5">+{imageCount - 5}</span>
        )}
      </div>
    )}
  </div>

  <div class="flex flex-col flex-grow p-4">
    <div class="mb-1">
      <p class="font-heading font-bold text-lg text-accent leading-tight">
        {formattedPrice}
        {priceType === 'arriendo' && (
          <span class="text-sm font-normal text-text-muted">/mes</span>
        )}
      </p>
      {adminFee != null && adminFee > 0 && priceType === 'arriendo' && (
        <p class="text-xs text-text-muted mt-0.5">
          Admin: {formatPrice(adminFee)}
        </p>
      )}
    </div>

    <h3 class="font-heading font-semibold text-text-primary text-sm leading-snug truncate mb-1 group-hover:text-primary transition-colors">
      {title}
    </h3>

    <div class="flex items-center gap-1.5 text-text-secondary text-xs mb-2">
      <svg class="w-3.5 h-3.5 flex-shrink-0 text-text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" />
        <circle cx="12" cy="10" r="3" />
      </svg>
      <span class="truncate">{location}</span>
    </div>

    <span class="inline-block self-start text-[10px] text-text-muted bg-surface-alt rounded px-1.5 py-0.5 mb-3 font-medium uppercase tracking-wide">
      {propertyTypeLabel}
    </span>

    <div class="mt-auto pt-3 border-t border-border">
      <div class="flex items-center justify-between text-text-secondary text-xs">
        <div class="flex items-center gap-1" title={`${area} m\u00B2`}>
          <svg class="w-3.5 h-3.5 text-navy" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21.3 15.3a2.4 2.4 0 0 1 0 3.4l-2.6 2.6a2.4 2.4 0 0 1-3.4 0L2.7 8.7a2.41 2.41 0 0 1 0-3.4l2.6-2.6a2.41 2.41 0 0 1 3.4 0Z" />
            <path d="m14.5 12.5 2-2" />
            <path d="m11.5 9.5 2-2" />
            <path d="m8.5 6.5 2-2" />
            <path d="m17.5 15.5 2-2" />
          </svg>
          <span>{area} m&sup2;</span>
        </div>

        {bedrooms > 0 && (
          <div class="flex items-center gap-1" title={`${bedrooms} habitacion(es)`}>
            <svg class="w-3.5 h-3.5 text-navy" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M2 20v-8a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v8" />
              <path d="M4 10V6a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v4" />
              <path d="M12 4v6" />
              <path d="M2 18h20" />
            </svg>
            <span>{bedrooms}</span>
          </div>
        )}

        {bathrooms > 0 && (
          <div class="flex items-center gap-1" title={`${bathrooms} bano(s)`}>
            <svg class="w-3.5 h-3.5 text-navy" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 6 6.5 3.5a1.5 1.5 0 0 0-1-.5C4.683 3 4 3.683 4 4.5V17a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-5" />
              <line x1="10" x2="8" y1="5" y2="7" />
              <line x1="2" x2="22" y1="12" y2="12" />
              <line x1="7" x2="7" y1="19" y2="21" />
              <line x1="17" x2="17" y1="19" y2="21" />
            </svg>
            <span>{bathrooms}</span>
          </div>
        )}

        {parking > 0 && (
          <div class="flex items-center gap-1" title={`${parking} parqueadero(s)`}>
            <svg class="w-3.5 h-3.5 text-navy" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.4 2.9A3.7 3.7 0 0 0 2 12v4c0 .6.4 1 1 1h2" />
              <circle cx="7" cy="17" r="2" />
              <path d="M9 17h6" />
              <circle cx="17" cy="17" r="2" />
            </svg>
            <span>{parking}</span>
          </div>
        )}
      </div>
    </div>
  </div>
</a>
