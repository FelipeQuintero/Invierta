---
import { CLIENT_ACCESS, PSE_PAYMENT, QUICK_LINKS } from '../../lib/constants';
import { House, KeyRound, Wallet, Users, Home, ArrowUpRight } from 'lucide-react';

const CLIENT_ICONS = { owner: House, tenant: KeyRound, payment: Wallet } as const;
const QUICK_ICONS: Record<string, typeof Users> = { Users, Home };

const portals = CLIENT_ACCESS.filter((item) => !item.featured);
const payments = CLIENT_ACCESS.filter((item) => item.featured);
---

<div class="hidden md:block bg-primary-dark text-white" id="top-bar">
  <div class="container-custom">
    <div class="flex items-center justify-between gap-4 py-2">
      <!-- Portales de clientes -->
      <nav class="flex items-center gap-1" aria-label="Portales de clientes">
        <span class="hidden xl:inline pr-2 text-[11px] font-semibold uppercase tracking-[0.14em] text-white/50">
          Zona de clientes
        </span>
        {portals.map((item) => {
          const Icon = CLIENT_ICONS[item.icon];
          return (
            <a
              href={item.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${item.label} (se abre en una pestaña nueva)`}
              class="group inline-flex items-center gap-1.5 rounded-md px-2.5 py-1 text-[13px] font-medium text-white/85 transition-colors duration-200 hover:bg-white/10 hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/60"
            >
              <Icon className="h-3.5 w-3.5 shrink-0 text-accent-light" aria-hidden="true" />
              <span>{item.label}</span>
              <ArrowUpRight className="h-3 w-3 shrink-0 opacity-50 transition-opacity group-hover:opacity-100" aria-hidden="true" />
            </a>
          );
        })}
      </nav>

      <div class="flex items-center gap-2">
        <!-- Enlaces secundarios -->
        <nav class="hidden lg:flex items-center gap-1 pr-2" aria-label="Enlaces rápidos">
          {QUICK_LINKS.map((link) => {
            const Icon = QUICK_ICONS[link.icon] || Users;
            return (
              <a
                href={link.href}
                class="inline-flex items-center gap-1.5 rounded-md px-2.5 py-1 text-[13px] text-white/70 transition-colors duration-200 hover:bg-white/10 hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/60"
              >
                <Icon className="h-3.5 w-3.5 shrink-0" aria-hidden="true" />
                <span>{link.label}</span>
              </a>
            );
          })}
        </nav>

        <!-- Pagos -->
        {payments.map((item) => {
          const Icon = CLIENT_ICONS[item.icon];
          return (
            <a
              href={item.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${item.label} (se abre en una pestaña nueva)`}
              class="inline-flex items-center gap-1.5 rounded-full bg-accent px-3.5 py-1 text-[13px] font-semibold text-white transition-colors duration-200 hover:bg-accent-dark focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/60"
            >
              <Icon className="h-3.5 w-3.5 shrink-0" aria-hidden="true" />
              <span>{item.shortLabel}</span>
            </a>
          );
        })}
        <a
          href={PSE_PAYMENT.href}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`${PSE_PAYMENT.label}: estudios y otros pagos (se abre en una pestaña nueva)`}
          class="inline-flex items-center gap-1.5 rounded-full bg-white py-0.5 pl-1 pr-3.5 text-[13px] font-semibold text-primary transition-colors duration-200 hover:bg-surface-alt focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/60"
        >
          <span class="flex h-6 w-6 shrink-0 items-center justify-center overflow-hidden rounded-full bg-white">
            <img
              src={PSE_PAYMENT.logo}
              alt=""
              width="24"
              height="24"
              class="h-full w-full object-contain"
              onerror="this.hidden=true;this.nextElementSibling.hidden=false;"
            />
            <span hidden class="text-[8px] font-extrabold tracking-tight text-navy">PSE</span>
          </span>
          <span>{PSE_PAYMENT.label}</span>
        </a>
      </div>
    </div>
  </div>
</div>
