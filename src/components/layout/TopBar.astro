---
import { TOP_BAR_LINKS } from '../../lib/constants';
---

<div class="hidden md:block bg-primary-dark" id="top-bar">
  <div class="container-custom">
    <div class="flex items-center justify-end gap-1 py-1.5">
      {TOP_BAR_LINKS.map((link, index) => (
        <>
          {index > 0 && (
            <span class="text-white/20 text-xs select-none" aria-hidden="true">|</span>
          )}
          <a
            href={link.href}
            class="inline-flex items-center gap-1.5 px-2.5 py-0.5 text-xs text-white/70 hover:text-white transition-colors duration-200"
            {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-3 w-3 shrink-0"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              {link.icon === 'User' && (
                <>
                  <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2" />
                  <circle cx="12" cy="7" r="4" />
                </>
              )}
              {link.icon === 'UserCheck' && (
                <>
                  <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                  <circle cx="9" cy="7" r="4" />
                  <polyline points="16 11 18 13 22 9" />
                </>
              )}
              {link.icon === 'CreditCard' && (
                <>
                  <rect width="22" height="16" x="1" y="4" rx="2" ry="2" />
                  <line x1="1" y1="10" x2="23" y2="10" />
                </>
              )}
              {link.icon === 'Home' && (
                <>
                  <path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8" />
                  <path d="M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                </>
              )}
              {link.icon === 'Users' && (
                <>
                  <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                  <circle cx="9" cy="7" r="4" />
                  <path d="M22 21v-2a4 4 0 0 0-3-3.87" />
                  <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                </>
              )}
            </svg>
            <span>{link.label}</span>
          </a>
        </>
      ))}
    </div>
  </div>
</div>
