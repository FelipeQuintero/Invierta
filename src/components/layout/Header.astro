---
import { SITE_CONFIG, NAV_LINKS, CLIENT_ACCESS } from '../../lib/constants';
import Navbar from './Navbar.astro';
import TopBar from './TopBar.astro';
import MobileMenu from './MobileMenu.tsx';
import { Wallet } from 'lucide-react';

// Acceso de pago siempre visible en móvil (la barra superior se oculta en pantallas pequeñas)
const rentPayment = CLIENT_ACCESS.find((item) => item.featured);
---

<TopBar />

<header
  class="sticky top-0 z-50 w-full bg-white/80 backdrop-blur-md border-b border-border/50"
  id="site-header"
>
  <div class="container-custom">
    <div class="flex h-16 items-center justify-between gap-4 lg:h-20">
      <!-- Logo -->
      <a href="/" class="flex items-center shrink-0" aria-label={`${SITE_CONFIG.name} - Inicio`}>
        <img
          src={SITE_CONFIG.headerLogo || SITE_CONFIG.logo}
          alt={`${SITE_CONFIG.name} Logo`}
          class="h-10 w-auto lg:h-12 drop-shadow-[0_1px_1px_rgba(0,0,0,0.12)]"
          width="120"
          height="48"
          loading="eager"
        />
      </a>

      <!-- Desktop Navigation -->
      <Navbar navLinks={NAV_LINKS} />

      <!-- Desktop CTA -->
      <div class="hidden lg:flex items-center gap-4">
        <a href="/servicios" class="btn-secondary text-sm">
          Contactar
        </a>
      </div>

      <!-- Móvil y tablet: pago rápido + menú -->
      <div class="flex items-center gap-2 lg:hidden">
        {rentPayment && (
          <a
            href={rentPayment.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${rentPayment.label} (se abre en una pestaña nueva)`}
            class="inline-flex min-h-[40px] items-center gap-1.5 whitespace-nowrap rounded-full bg-accent px-3 text-[13px] font-semibold text-white shadow-sm md:hidden transition-colors hover:bg-accent-dark focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2"
          >
            <Wallet className="h-4 w-4 shrink-0" aria-hidden="true" />
            <span class="min-[400px]:hidden">Pagar</span>
            <span class="hidden min-[400px]:inline">{rentPayment.shortLabel}</span>
          </a>
        )}
        <MobileMenu client:load />
      </div>
    </div>
  </div>
</header>

<script>
  const header = document.getElementById('site-header');
  if (header) {
    window.addEventListener('scroll', () => {
      const currentScroll = window.scrollY;
      if (currentScroll > 10) {
        header.classList.add('shadow-lg');
      } else {
        header.classList.remove('shadow-lg');
      }
    }, { passive: true });
  }
</script>
