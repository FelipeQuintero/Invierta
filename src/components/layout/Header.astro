---
import { SITE_CONFIG, NAV_LINKS } from '../../lib/constants';
import Navbar from './Navbar.astro';
import MobileMenu from './MobileMenu.tsx';
---

<header
  class="sticky top-0 z-50 w-full bg-primary"
  id="site-header"
>
  <div class="container-custom">
    <div class="flex h-16 items-center justify-between gap-4 lg:h-20">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2.5 shrink-0" aria-label={`${SITE_CONFIG.name} - Inicio`}>
        <img
          src={SITE_CONFIG.logo}
          alt={`${SITE_CONFIG.name} Logo`}
          class="h-8 w-auto lg:h-10"
          width="40"
          height="40"
          loading="eager"
        />
        <span class="font-[family-name:var(--font-family-heading)] text-xl lg:text-2xl font-bold tracking-tight text-white">
          INVI<span class="bg-gradient-to-r from-[var(--color-brand-purple)] to-[var(--color-brand-orange)] bg-clip-text text-transparent">E</span>RTA
        </span>
      </a>

      <!-- Desktop Navigation -->
      <Navbar navLinks={NAV_LINKS} />

      <!-- Desktop CTA + Menu Icon -->
      <div class="hidden md:flex items-center gap-4">
        <a href="/servicios" class="btn-secondary text-sm">
          Contactar
        </a>
        <!-- Hamburger Menu Icon (decorative on desktop) -->
        <button class="hidden lg:flex items-center justify-center w-10 h-10 text-white/70 hover:text-white transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>

      <!-- Mobile Menu -->
      <MobileMenu client:load />
    </div>
  </div>
</header>

<script>
  // Add shadow on scroll
  const header = document.getElementById('site-header');
  if (header) {
    window.addEventListener('scroll', () => {
      const currentScroll = window.scrollY;
      if (currentScroll > 10) {
        header.classList.add('shadow-lg');
      } else {
        header.classList.remove('shadow-lg');
      }
    }, { passive: true });
  }
</script>
