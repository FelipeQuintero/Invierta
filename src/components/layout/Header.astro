---
import { SITE_CONFIG, NAV_LINKS } from '../../lib/constants';
import Navbar from './Navbar.astro';
import MobileMenu from './MobileMenu.tsx';
---

<header
  class="sticky top-0 z-50 w-full border-b border-border bg-white/95 backdrop-blur-md supports-[backdrop-filter]:bg-white/80"
  id="site-header"
>
  <!-- Top bar (optional subtle info bar) -->
  <div class="hidden lg:block bg-primary text-white">
    <div class="container-custom flex items-center justify-between py-1.5 text-xs">
      <div class="flex items-center gap-4">
        <a
          href={`tel:${SITE_CONFIG.phone}`}
          class="flex items-center gap-1.5 hover:text-secondary-light transition-colors"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
          </svg>
          {SITE_CONFIG.phone}
        </a>
        <a
          href={`mailto:${SITE_CONFIG.email}`}
          class="flex items-center gap-1.5 hover:text-secondary-light transition-colors"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="20" height="16" x="2" y="4" rx="2"/>
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
          </svg>
          {SITE_CONFIG.email}
        </a>
      </div>
      <div class="flex items-center gap-3">
        {SITE_CONFIG.socialMedia.facebook && (
          <a
            href={SITE_CONFIG.socialMedia.facebook}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Facebook"
            class="hover:text-secondary-light transition-colors"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor">
              <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
            </svg>
          </a>
        )}
        {SITE_CONFIG.socialMedia.instagram && (
          <a
            href={SITE_CONFIG.socialMedia.instagram}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram"
            class="hover:text-secondary-light transition-colors"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="20" height="20" x="2" y="2" rx="5" ry="5"/>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
              <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/>
            </svg>
          </a>
        )}
      </div>
    </div>
  </div>

  <!-- Main Navigation Bar -->
  <div class="container-custom">
    <div class="flex h-16 items-center justify-between gap-4 lg:h-[4.5rem]">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2.5 shrink-0" aria-label={`${SITE_CONFIG.name} - Inicio`}>
        <img
          src={SITE_CONFIG.logo}
          alt={`${SITE_CONFIG.name} Logo`}
          class="h-9 w-auto lg:h-10"
          width="160"
          height="40"
          loading="eager"
        />
      </a>

      <!-- Desktop Navigation -->
      <Navbar navLinks={NAV_LINKS} />

      <!-- Desktop CTA -->
      <div class="hidden md:flex items-center gap-3">
        <a href="/servicios" class="btn-primary text-sm">
          Contactar
        </a>
      </div>

      <!-- Mobile Menu -->
      <MobileMenu client:load />
    </div>
  </div>
</header>

<script>
  // Add shadow on scroll
  const header = document.getElementById('site-header');
  if (header) {
    let lastScroll = 0;
    window.addEventListener('scroll', () => {
      const currentScroll = window.scrollY;
      if (currentScroll > 10) {
        header.classList.add('shadow-sm');
      } else {
        header.classList.remove('shadow-sm');
      }
      lastScroll = currentScroll;
    }, { passive: true });
  }
</script>
