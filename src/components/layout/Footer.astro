---
import { SITE_CONFIG, NAV_LINKS, SERVICES } from '../../lib/constants';

const currentYear = new Date().getFullYear();
---

<footer class="bg-primary text-white" role="contentinfo">
  <!-- Main Footer Content -->
  <div class="container-custom py-12 lg:py-16">
    <div class="grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-4 lg:gap-8">
      <!-- Column 1: Company Info -->
      <div class="sm:col-span-2 lg:col-span-1">
        <a href="/" class="inline-block mb-4" aria-label={`${SITE_CONFIG.name} - Inicio`}>
          <img
            src={SITE_CONFIG.logo}
            alt={`${SITE_CONFIG.name} Logo`}
            class="h-10 w-auto lg:h-12"
            width="120"
            height="48"
            loading="lazy"
          />
        </a>
        <p class="text-sm leading-relaxed text-white/70 max-w-xs mb-5">
          Tu aliado inmobiliario de confianza en Colombia. Venta, arriendo y servicios inmobiliarios
          con asesoría profesional personalizada.
        </p>
        <div class="flex items-start gap-2 text-sm text-white/60">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mt-0.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/>
            <circle cx="12" cy="10" r="3"/>
          </svg>
          <span>{SITE_CONFIG.address}</span>
        </div>
        <p class="text-sm text-slate-400 mt-1">Eje Cafetero &middot; Bogotá &middot; Cali &middot; Medellín</p>
      </div>

      <!-- Column 2: Navigation -->
      <div>
        <h3 class="font-heading text-base font-semibold mb-5 text-white">
          Navegación
        </h3>
        <ul class="space-y-3">
          {NAV_LINKS.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-sm text-white/60 transition-colors duration-200 hover:text-secondary-light"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Column 3: Services -->
      <div>
        <h3 class="font-heading text-base font-semibold mb-5 text-white">
          Servicios
        </h3>
        <ul class="space-y-3">
          {SERVICES.map((service) => (
            <li>
              <a
                href={`/servicios/${service.slug}`}
                class="text-sm text-white/60 transition-colors duration-200 hover:text-secondary-light"
              >
                {service.title}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Column 4: Contact -->
      <div>
        <h3 class="font-heading text-base font-semibold mb-5 text-white">
          Contacto
        </h3>
        <ul class="space-y-4">
          <li>
            <a
              href={`tel:${SITE_CONFIG.phone}`}
              class="flex items-center gap-2.5 text-sm text-white/60 transition-colors duration-200 hover:text-secondary-light"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0 text-secondary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
              </svg>
              {SITE_CONFIG.phone}
            </a>
          </li>
          <li>
            <a
              href={`mailto:${SITE_CONFIG.email}`}
              class="flex items-center gap-2.5 text-sm text-white/60 transition-colors duration-200 hover:text-secondary-light"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0 text-secondary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="20" height="16" x="2" y="4" rx="2"/>
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
              </svg>
              {SITE_CONFIG.email}
            </a>
          </li>
          <li>
            <a
              href={`https://wa.me/${SITE_CONFIG.whatsapp}`}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-2.5 text-sm text-white/60 transition-colors duration-200 hover:text-secondary-light"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0 text-[#25D366]" viewBox="0 0 24 24" fill="currentColor">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/>
              </svg>
              WhatsApp
            </a>
          </li>
        </ul>

        <!-- Social Media Icons -->
        <div class="mt-6 flex items-center gap-3">
          {SITE_CONFIG.socialMedia.facebook && (
            <a
              href={SITE_CONFIG.socialMedia.facebook}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Facebook"
              class="flex h-9 w-9 items-center justify-center rounded-full bg-white/10 text-white/70 transition-all duration-200 hover:bg-secondary hover:text-white"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor">
                <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
              </svg>
            </a>
          )}
          {SITE_CONFIG.socialMedia.instagram && (
            <a
              href={SITE_CONFIG.socialMedia.instagram}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Instagram"
              class="flex h-9 w-9 items-center justify-center rounded-full bg-white/10 text-white/70 transition-all duration-200 hover:bg-secondary hover:text-white"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="20" height="20" x="2" y="2" rx="5" ry="5"/>
                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
                <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/>
              </svg>
            </a>
          )}
          {SITE_CONFIG.socialMedia.youtube && (
            <a
              href={SITE_CONFIG.socialMedia.youtube}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="YouTube"
              class="flex h-9 w-9 items-center justify-center rounded-full bg-white/10 text-white/70 transition-all duration-200 hover:bg-secondary hover:text-white"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor">
                <path d="M19.615 3.184c-3.604-.246-11.631-.245-15.23 0-3.897.266-4.356 2.62-4.385 8.816.029 6.185.484 8.549 4.385 8.816 3.6.245 11.626.246 15.23 0 3.897-.266 4.356-2.62 4.385-8.816-.029-6.185-.484-8.549-4.385-8.816zM9 16V8l8 4-8 4z"/>
              </svg>
            </a>
          )}
          {SITE_CONFIG.socialMedia.linkedin && (
            <a
              href={SITE_CONFIG.socialMedia.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="LinkedIn"
              class="flex h-9 w-9 items-center justify-center rounded-full bg-white/10 text-white/70 transition-all duration-200 hover:bg-secondary hover:text-white"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor">
                <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
                <rect width="4" height="12" x="2" y="9"/>
                <circle cx="4" cy="4" r="2"/>
              </svg>
            </a>
          )}
        </div>

        <!-- Google Reviews — TODO: reemplazar con el Place ID real de Invierta Inmobiliaria para link directo de reseñas -->
        <a href="https://www.google.com/maps/place/Invierta+Inmobiliaria/@4.8087,-75.6906,15z" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-sm text-white/60 hover:text-secondary-light transition-colors mt-3" title="Califícanos en Google">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          Califícanos en Google
        </a>
      </div>
    </div>
  </div>

  <!-- Bottom Bar -->
  <div class="border-t border-white/10">
    <div class="container-custom flex flex-col items-center justify-between gap-3 py-5 sm:flex-row">
      <p class="text-xs text-white/50">
        &copy; {currentYear} {SITE_CONFIG.name}. Todos los derechos reservados.
      </p>
      <p class="text-xs text-white/40">
        Powered by <span class="text-secondary-light font-medium">Invierta</span>
      </p>
    </div>
  </div>
</footer>
